{
  "name": "madebykreativ-com",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.8.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "validate:html": "html-validate --config .htmlvalidate.json \"dist/**/*.html\"",
    "validate:links": "node scripts/check-local-links.mjs",
    "validate:artifact": "node scripts/check-built-site.mjs",
    "validate": "npm run validate:attribution && npm run validate:assets && npm run validate:inquiries && npm run validate:api-demo && npm run build && npm run validate:html && npm run validate:links && npm run validate:artifact && npm run validate:redirects",
    "validate:assets": "node --test scripts/shared-assets.test.mjs scripts/public-email.test.mjs",
    "validate:inquiries": "node --test infrastructure/inquiries/handler.test.mjs scripts/leads.test.mjs",
    "validate:api-demo": "node scripts/prepare-api-demo-report.mjs --check",
    "build:inquiries": "esbuild infrastructure/inquiries/worker.mjs --bundle --format=esm --platform=browser --external:cloudflare:email --minify --outfile=infrastructure/inquiries/bundle.mjs",
    "leads": "node scripts/leads.mjs",
    "validate:attribution": "node --test scripts/app-attribution.test.mjs",
    "validate:browser": "playwright test --project=chromium",
    "validate:cross-browser": "playwright test --project=firefox --project=webkit",
    "validate:storefronts": "node scripts/check-storefronts.mjs",
    "validate:portfolio": "node scripts/check-services-portfolio.mjs",
    "validate:production": "node scripts/check-production.mjs",
    "redirects:export": "node scripts/export-cloudflare-redirects.mjs",
    "validate:redirects": "node --test scripts/redirect-rules.test.mjs && node scripts/export-cloudflare-redirects.mjs --check",
    "validate:performance": "node scripts/check-performance.mjs",
    "assets:web": "node scripts/prepare-web-assets.mjs",
    "assets:client": "node scripts/prepare-client-assets.mjs",
    "assets:services": "node scripts/prepare-services-assets.mjs",
    "check": "npm run validate && npm run validate:browser"
  },
  "overrides": {
    "linkinator": {
      "glob": "^14.0.6"
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "mimetext": "^3.0.28",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "astro": "^7.4.8",
    "chrome-launcher": "^1.2.3",
    "html-validate": "^11.21.0",
    "htmlparser2": "^12.0.0",
    "lighthouse": "^13.6.0",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5"
  }
}
