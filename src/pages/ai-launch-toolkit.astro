---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="The KREATIV Product-to-Profit System | Made by Kreativ"
  description="The historical AI Launch Toolkit is no longer the primary path. The curated AI Prompt Companion is included in Product-to-Profit."
  canonicalPath="/product-to-profit/system/"
  robots="noindex,follow"
  redirectTo="/product-to-profit/system/"
>
  <section class="redirect-page" aria-labelledby="redirect-heading">
    <img src="/product-to-profit/covers/system.png" width="320" height="180" alt="The KREATIV Product-to-Profit System cover" />
    <p class="eyebrow">Current complete system</p>
    <h1 id="redirect-heading">The AI Toolkit has moved into Product-to-Profit.</h1>
    <p>The old all-in-one toolkit is historical. The current bundle uses a curated AI Prompt Companion inside the stage-based system.</p>
    <a class="button-cta button-cta-primary" href="/product-to-profit/system/">Open the complete system</a>
  </section>
  <script is:inline>window.location.replace("/product-to-profit/system/" + window.location.search + window.location.hash);</script>
</BaseLayout>
