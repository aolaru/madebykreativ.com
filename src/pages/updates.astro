---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroHeader from "../components/HeroHeader.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getUpdates } from "../data/updates";
const updates = await getUpdates();
const kinds = [...new Set(updates.map((entry) => entry.kind))];
const formatDate = (date: string) =>
  new Date(`${date}T00:00:00Z`).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  });
---

<BaseLayout
  title="Updates | Made by Kreativ"
  description="Product releases, project announcements, and website improvements in one chronological archive."
  canonicalPath="/updates/"
>
  <HeroHeader
    current="updates"
    eyebrow="Releases and changes"
    title="Updates"
    tagline="Product releases, project notes, and website improvements."
  />
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Updates" }]} />
  <section class="news-tools updates-tools" aria-label="Find updates">
    <label class="news-search">
      <span>Search updates</span>
      <input
        type="search"
        data-news-search-input
        placeholder="Search releases and changes"
      />
    </label>
    <div class="news-filter-row" role="group" aria-label="Filter updates">
      <button
        class="status-filter-button"
        type="button"
        data-news-filter="all"
        aria-pressed="true"
      >
        All
      </button>
      {kinds.map((kind) => (
        <button
          class="status-filter-button"
          type="button"
          data-news-filter={kind}
          aria-pressed="false"
        >
          {kind}
        </button>
      ))}
    </div>
    <p>
      <a class="cta" href="/updates/rss.xml">
        RSS feed
      </a>{" "}
      ·{" "}
      <span data-updates-count role="status" aria-live="polite">
        {updates.length} updates
      </span>
    </p>
  </section>
  <ol
    class="updates-list unified-updates"
    aria-label="All updates, newest first"
  >
    {updates.map((entry) => (
      <li
        id={entry.id}
        class="updates-list-item"
        data-news-entry
        data-news-category={entry.kind}
        data-news-search={`${entry.title} ${entry.description} ${entry.kind}`.toLowerCase()}
      >
        <time datetime={entry.date}>{formatDate(entry.date)}</time>
        <span class="updates-kind">{entry.kind}</span>
        <div>
          <h2>
            {entry.href ? <a href={entry.href}>{entry.title}</a> : entry.title}
          </h2>
          <p>{entry.description}</p>
        </div>
      </li>
    ))}
  </ol>
  <p data-news-empty-state hidden>
    No updates match that search.
  </p>
  <button
    class="button-cta button-cta-secondary"
    type="button"
    data-updates-more
    hidden
  >
    Show older updates
  </button>
  <SiteFooter />
</BaseLayout>
