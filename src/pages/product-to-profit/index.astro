---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ProductCover from "../../components/ProductCover.astro";
import ProductStoreAction from "../../components/ProductStoreAction.astro";
import SystemStagePath from "../../components/SystemStagePath.astro";
import {
  productToProfitProducts,
  scorecardProduct,
  bundleProduct,
  productPath,
} from "../../data/productToProfit";
---

<BaseLayout
  title="KREATIV Product-to-Profit System | Made by Kreativ"
  description="Choose an idea, create a useful digital product, and launch it. Compare two free entry products, three focused paid tools, and the €39 complete system."
  canonicalPath="/product-to-profit/"
>
  <header class="ptp-overview-header ptp-accent-teal">
    <SiteNav current="guides" />
    <div class="ptp-overview-hero">
      <div class="ptp-overview-copy">
        <p class="eyebrow">KREATIV Product-to-Profit</p>
        <h1>Choose a product worth testing</h1>
        <p class="ptp-overview-promise">
          Choose an idea. Create something useful. Launch it and learn from real
          responses.
        </p>
        <div class="landing-actions">
          <ProductStoreAction
            product={scorecardProduct}
            page="overview"
            position="hero"
            showStatus={false}
          />
          <a class="cta" href="#comparison">
            Compare products
          </a>
        </div>
        <p>
          The free Scorecard is the recommended start. No guaranteed traffic,
          customers, sales, or income.
        </p>
      </div>
      <a
        class="ptp-overview-cover-link"
        href={productPath(scorecardProduct.slug)}
      >
        <ProductCover
          src={scorecardProduct.cover}
          alt={scorecardProduct.coverAlt}
          loading="eager"
        />
      </a>
    </div>
    <SystemStagePath compact />
  </header>
  <section
    class="ptp-section"
    id="comparison"
    aria-labelledby="comparison-heading"
  >
    <h2 id="comparison-heading">Choose your next step</h2>
    <p>
      Buy only what you need. The two free products are available for €0 on
      Gumroad; optional payments are welcome.
    </p>
    <section class="ptp-table-wrap" aria-label="Product comparison">
      <table class="ptp-comparison-table">
        <thead>
          <tr>
            <th scope="col">Product</th>
            <th scope="col">Start with</th>
            <th scope="col">Leave with</th>
            <th scope="col">Price</th>
          </tr>
        </thead>
        <tbody>
          {productToProfitProducts.map((product) => (
            <tr
              class:list={[
                product.slug === scorecardProduct.slug &&
                  "ptp-comparison-recommended",
              ]}
            >
              <th scope="row">
                <a href={productPath(product.slug)}>
                  <span>{product.stage}</span>
                  {product.shortTitle}
                </a>
              </th>
              <td data-label="Start with">{product.requiredInput}</td>
              <td data-label="Leave with">{product.output}</td>
              <td data-label="Price">
                <strong class="ptp-table-price">{product.price}</strong>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
    <p>
      <a class="cta" href="/product-to-profit/example/">
        See a completed fictional example
      </a>
    </p>
  </section>
  <section class="ptp-section" aria-labelledby="products-heading">
    <h2 id="products-heading">Inspect the products</h2>
    <div class="ptp-product-grid">
      {productToProfitProducts
        .filter((product) => product.slug !== "system")
        .map((product) => (
          <article
            class:list={["ptp-product-card", `ptp-accent-${product.accent}`]}
          >
            <a href={productPath(product.slug)} class="ptp-product-card-cover">
              <ProductCover
                src={product.cover}
                alt={product.coverAlt}
                sizes="(max-width:700px) calc(100vw - 2rem),460px"
              />
            </a>
            <div class="ptp-product-card-body">
              <span
                class:list={[
                  "ptp-access-badge",
                  `ptp-access-${product.access}`,
                ]}
              >
                {product.accessSummary}
              </span>
              <h3>
                <a href={productPath(product.slug)}>{product.shortTitle}</a>
              </h3>
              <p>{product.promise}</p>
              <a class="cta" href={productPath(product.slug)}>
                Details and workbook previews
              </a>
            </div>
          </article>
        ))}
    </div>
  </section>
  <section
    class="ptp-section ptp-bundle-section"
    aria-labelledby="bundle-heading"
  >
    <div class="ptp-bundle-layout">
      <div>
        <p class="eyebrow">Complete system · paid</p>
        <h2 id="bundle-heading">All six products. One connected workspace.</h2>
        <p class="ptp-bundle-price">{bundleProduct.price}</p>
        <p>
          Includes the integrated master workspace, stage handoffs, and three
          implementation tracks. The case study and sample DOCX files are also
          included with the standalone Builder, not exclusive bundle bonuses.
        </p>
        <div class="landing-actions">
          <ProductStoreAction
            product={bundleProduct}
            page="overview"
            position="bundle"
            showStatus={false}
          />
          <a class="cta" href={productPath("system")}>
            Bundle contents
          </a>
        </div>
        <p>
          <a class="cta" href="/product-to-profit/product-information/">
            License, compatibility, support, and refund policies
          </a>
        </p>
      </div>
      <ProductCover src={bundleProduct.cover} alt={bundleProduct.coverAlt} />
    </div>
  </section>
  <SiteFooter />
</BaseLayout>
