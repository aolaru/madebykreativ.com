---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroHeader from "../../components/HeroHeader.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { apps } from "../../data/apps";
import AppScreenshot from "../../components/AppScreenshot.astro";
import AppStoreLink from "../../components/AppStoreLink.astro";
import {
  buildUrl,
  createBreadcrumbSchema,
  organizationSchema,
} from "../../data/site";

const description =
  "Explore PhotoFeather, ShareSafe, Northlight, PaperBuild and Kreativ Font for Android. Compare free features, optional Pro tools and official Google Play links.";
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Kreativ Apps",
  description,
  url: buildUrl("/apps/"),
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: apps.length,
    itemListElement: apps.map((app, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "SoftwareApplication",
        name: app.name,
        description: app.description,
        operatingSystem: [
          ...new Set(app.stores.map((store) => store.platform)),
        ].join(", "),
        url: buildUrl(`/apps/${app.slug}/`),
        image: buildUrl(`/apps/${app.slug}/icon.png`),
        installUrl: app.stores.map((store) => store.url),
      },
    })),
  },
};
---

<BaseLayout
  title="Kreativ Apps | Made by Kreativ"
  description={description}
  canonicalPath="/apps/"
  ogImage={buildUrl("/og-apps.png")}
  ogImageAlt="PhotoFeather, ShareSafe, Northlight, PaperBuild and Kreativ Font Android apps."
  structuredData={[
    organizationSchema,
    collectionSchema,
    createBreadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Apps", path: "/apps/" },
    ]),
  ]}
>
  <HeroHeader
    current="apps"
    eyebrow="Made by Kreativ"
    title="Kreativ Apps"
    tagline="Small, focused tools for everyday tasks."
  />
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Apps" }]} />

  <section class="apps-catalogue" aria-label="Available mobile apps">
    {apps.map((app) => (
      <article class="apps-card" aria-labelledby={`${app.slug}-heading`}>
        <div class="apps-card-heading">
          <img
            src={`/apps/${app.slug}/icon.png`}
            alt=""
            width="56"
            height="56"
          />
          <div>
            <p class="eyebrow">{app.category}</p>
            <h2 id={`${app.slug}-heading`}>
              <a href={`/apps/${app.slug}/`}>{app.name}</a>
            </h2>
          </div>
        </div>
        <div class="apps-card-meta">
          {[...new Set(app.stores.map((store) => store.platform))].map(
            (platform) => (
              <span class="apps-platform">{platform}</span>
            ),
          )}
          <span>{app.accessLabel}</span>
        </div>
        <p class="apps-card-description">{app.description}</p>
        <a
          class="apps-card-preview"
          href={`/apps/${app.slug}/`}
          aria-label={`See ${app.name} screenshots and details`}
        >
          <AppScreenshot
            slug={app.slug}
            alt={`${app.name} app interface.`}
            width={app.screenshotWidth}
            height={app.screenshotHeight}
            loading="lazy"
          />
        </a>
        <div class="apps-card-actions">
          {app.stores.map((store) => (
            <AppStoreLink url={store.url} name={store.name} position="catalogue" />
          ))}
          <a class="cta" href={`/apps/${app.slug}/`}>
            App details
          </a>
        </div>
        <p class="apps-card-policies">
          <a href={app.privacyUrl}>Privacy policy</a>
          <a href={`/apps/support/?app=${app.slug}`}>Support</a>
        </p>
      </article>
    ))}
  </section>
  <section class="apps-contact" aria-labelledby="apps-contact-heading">
    <div>
      <h2 id="apps-contact-heading">Questions about an app?</h2>
      <p>Get help with a purchase, report a problem, or share feedback.</p>
    </div>
    <a class="cta" href="/apps/support/">
      App support
    </a>
  </section>
</BaseLayout>
