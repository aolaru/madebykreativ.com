---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { apps } from "../../data/apps";
export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}
const { app } = Astro.props;
const platforms = [...new Set(app.stores.map((store) => store.platform))].join(
  " and ",
);
---

<BaseLayout
  title={`${app.name} for ${platforms} | Made by Kreativ`}
  description={app.description}
  canonicalPath={`/apps/${app.slug}/`}
>
  <SiteNav current="apps" />
  <header class="app-hero">
    <div>
      <img src={`/apps/${app.slug}/icon.png`} width="80" height="80" alt="" />
      <p class="eyebrow">
        {platforms} · {app.accessLabel}
      </p>
      <h1>{app.name}</h1>
      <p>{app.description}</p>
      <div class="landing-actions">
        {app.stores.map((store) => (
          <a
            class="button-cta button-cta-primary"
            href={store.url}
            target="_blank"
            rel="noopener"
          >
            Get it on {store.name}
          </a>
        ))}
        <a class="cta" href={`/privacy/${app.slug}/`}>
          App privacy policy
        </a>
      </div>
    </div>
    <img
      class="app-screen"
      src={`/apps/${app.slug}/screen.png`}
      width="1080"
      height={app.screenshotHeight}
      alt={`${app.name} app screenshot.`}
    />
  </header>
  <Breadcrumbs
    items={[
      { label: "Home", href: "/" },
      { label: "Apps", href: "/apps/" },
      { label: app.name },
    ]}
  />
  <section class="ptp-section">
    <h2>What you can do</h2>
    <ul>
      {app.features.map((feature) => (
        <li>{feature}</li>
      ))}
    </ul>
    <p>No account, advertising, or developer-operated cloud processing.</p>
    <p>{app.proDescription}</p>
    <p>{app.limitation}</p>
    <p>
      <a class="cta" href="/contact/">
        App support
      </a>
    </p>
  </section>
  {app.slug === "sharesafe" && (
    <section class="content-card" aria-labelledby="sharesafe-tutorial-heading">
      <p class="eyebrow">Step-by-step guide</p>
      <h2 id="sharesafe-tutorial-heading">Clean a photo before you share it</h2>
      <p>Follow the free Privacy Check and metadata-cleaning workflow with real app screenshots, then review and share the new copy.</p>
      <p><a class="cta" href="/news/remove-photo-metadata-android-sharesafe/">Read the ShareSafe tutorial</a></p>
    </section>
  )}
  {app.slug === "northlight" && (
    <section class="content-card" aria-labelledby="northlight-tutorial-heading">
      <p class="eyebrow">Step-by-step guide</p>
      <h2 id="northlight-tutorial-heading">Read a compass heading on your Android phone</h2>
      <p>Follow the magnetic compass, calibration, spoken-heading, GPS altitude and light-tool steps with real Northlight screenshots.</p>
      <p><a class="cta" href="/news/offline-compass-android-northlight/">Read the Northlight tutorial</a></p>
    </section>
  )}
  <SiteFooter />
</BaseLayout>
