---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { apps } from "../../data/apps";
import AppScreenshot from "../../components/AppScreenshot.astro";
import AppStoreLink from "../../components/AppStoreLink.astro";
import RelatedApps from "../../components/RelatedApps.astro";
import {buildUrl} from "../../data/site";
export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}
const { app } = Astro.props;
const platforms = [...new Set(app.stores.map((store) => store.platform))].join(
  " and ",
);
---

<BaseLayout
  title={`${app.name} for ${platforms} | Made by Kreativ`}
  description={app.description}
  canonicalPath={`/apps/${app.slug}/`}
  ogImage={buildUrl(`/apps/${app.slug}/social.png`)}
  ogImageAlt={`${app.name} Android app and its real interface.`}
  structuredData={[{"@context":"https://schema.org", "@type":"SoftwareApplication", name:app.name, description:app.description, url:buildUrl(`/apps/${app.slug}/`), image:buildUrl(`/apps/${app.slug}/icon.png`), operatingSystem:platforms, applicationCategory:"UtilitiesApplication", installUrl:app.stores.map((store)=>store.url), offers:{"@type":"Offer",price:0,priceCurrency:"EUR",description:app.accessLabel}, author:{"@type":"Organization",name:"Made by Kreativ",url:buildUrl("/")}}]}
>
  <header class="app-hero">
    <div>
      <img src={`/apps/${app.slug}/icon.png`} width="80" height="80" alt="" />
      <p class="eyebrow">
        {platforms} · {app.accessLabel}
      </p>
      <h1>{app.name}</h1>
      <p>{app.description}</p>
      <div class="landing-actions">
        {app.stores.map((store) => (
          <AppStoreLink url={store.url} name={store.name} position="detail-hero" />
        ))}
        <a class="cta" href={app.privacyUrl}>
          App privacy policy
        </a>
      </div>
    </div>
    <AppScreenshot
      class="app-screen"
      slug={app.slug}
      width={app.screenshotWidth}
      height={app.screenshotHeight}
      alt={`${app.name} app screenshot.`}
      loading="eager"
    />
  </header>
  <Breadcrumbs
    items={[
      { label: "Home", href: "/" },
      { label: "Apps", href: "/apps/" },
      { label: app.name },
    ]}
  />
  <section class="ptp-section">
    <h2>What you can do</h2>
    <ul>
      {app.features.map((feature) => (
        <li>{feature}</li>
      ))}
    </ul>
    <p>{app.privacyNote}</p>
    <p>{app.proDescription}</p>
    <p>{app.limitation}</p>
    <p>
      <a class="cta" href={`/apps/support/?app=${app.slug}`}>
        App support
      </a>
    </p>
  </section>
  {app.slug === "kreativ-fancy-text" && (
    <section class="content-card" aria-labelledby="fancy-text-tutorial-heading">
      <p class="eyebrow">Step-by-step guide</p>
      <h2 id="fancy-text-tutorial-heading">Create fancy text and matching PNG designs on Android</h2>
      <p>Write a message, style individual words, preview artwork, export a PNG and keep a collection of local designs.</p>
      <p><a class="cta" href="/news/fancy-text-png-designs-android-kreativ/">Read the Kreativ Fancy Text tutorial</a></p>
    </section>
  )}
  {app.slug === "photofeather" && (
    <section class="content-card" aria-labelledby="photofeather-tutorial-heading">
      <p class="eyebrow">Step-by-step guide</p>
      <h2 id="photofeather-tutorial-heading">Make photos fit an upload limit on Android</h2>
      <p>Choose photos, resize or set a maximum file size, inspect measured results and compare before saving a new JPEG copy.</p>
      <p><a class="cta" href="/news/compress-photos-android-photofeather/">Read the PhotoFeather tutorial</a></p>
    </section>
  )}
  {app.slug === "sharesafe" && (
    <section class="content-card" aria-labelledby="sharesafe-tutorial-heading">
      <p class="eyebrow">Step-by-step guide</p>
      <h2 id="sharesafe-tutorial-heading">Clean a photo before you share it</h2>
      <p>Follow the free Privacy Check and metadata-cleaning workflow with real app screenshots, then review and share the new copy.</p>
      <p><a class="cta" href="/news/remove-photo-metadata-android-sharesafe/">Read the ShareSafe tutorial</a></p>
    </section>
  )}
  {app.slug === "northlight" && (
    <section class="content-card" aria-labelledby="northlight-tutorial-heading">
      <p class="eyebrow">Step-by-step guide</p>
      <h2 id="northlight-tutorial-heading">Read a compass heading on your Android phone</h2>
      <p>Follow the magnetic compass, calibration, spoken-heading, GPS altitude and light-tool steps with real Northlight screenshots.</p>
      <p><a class="cta" href="/news/offline-compass-android-northlight/">Read the Northlight tutorial</a></p>
    </section>
  )}
  {app.slug === "paperbuild" && (
    <section class="content-card" aria-labelledby="paperbuild-tutorial-heading">
      <p class="eyebrow">Step-by-step guide</p>
      <h2 id="paperbuild-tutorial-heading">Make a PDF from page photos on Android</h2>
      <p>Follow the free image import, manual crop, PDF export and Recent PDFs workflow with genuine app screenshots.</p>
      <p><a class="cta" href="/news/photos-to-pdf-android-paperbuild/">Read the PaperBuild tutorial</a></p>
    </section>
  )}
  {app.slug === "kreativ-font" && (
    <section class="content-card" aria-labelledby="kreativ-font-tutorial-heading">
      <p class="eyebrow">Step-by-step guide</p>
      <h2 id="kreativ-font-tutorial-heading">Discover fonts and save a shortlist on Android</h2>
      <p>Follow browsing, catalogue search, filters and bookmarking with real Kreativ Font screenshots.</p>
      <p><a class="cta" href="/news/discover-fonts-android-kreativ-font/">Read the Kreativ Font tutorial</a></p>
    </section>
  )}
  <RelatedApps slug={app.slug} />
</BaseLayout>
