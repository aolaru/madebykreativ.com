---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import HeroHeader from "../components/HeroHeader.astro";
import NewsEntry from "../components/NewsEntry.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { buildUrl, createNewsItemListSchema, organizationSchema } from "../data/site";

const toNewsPath = (id: string) => `/news/${id.replace(/\.md$/, "")}/`;

const newsEntries = (await getCollection("news"))
  .sort((a, b) => b.data.sortDate.valueOf() - a.data.sortDate.valueOf())
  .map((entry) => ({
    ...entry,
    path: toNewsPath(entry.id)
  }));

const latestNewsDate = newsEntries[0]?.data.sortDate;
const latestNewsLabel = latestNewsDate
  ? new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" }).format(latestNewsDate)
  : "May 13, 2026";
const categories = [...new Set(newsEntries.map((entry) => entry.data.category))];
---

<BaseLayout
  title="News Archive | Made by Kreativ"
  description="Product news, project status notes, and historical release notes from Made by Kreativ."
  canonicalPath="/news/"
  ogImage={buildUrl("/og-news.png")}
  ogImageAlt="Made by Kreativ project news archive card."
  structuredData={[organizationSchema, createNewsItemListSchema(newsEntries)]}
>
  <HeroHeader
    current="news"
    eyebrow="Product and project news"
    title="News"
    tagline="Occasional status notes and a historical record of earlier releases."
  >
    <p slot="afterTagline" class="meta-note">Last updated: {latestNewsLabel}</p>
  </HeroHeader>

  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "News" }]} />

  <section class="content-card news-tools" aria-labelledby="news-tools-heading">
    <div>
      <p class="eyebrow">Browse news</p>
      <h2 id="news-tools-heading">Find a status or release note</h2>
    </div>
    <label class="news-search">
      <span>Search news</span>
      <input type="search" placeholder="Search titles and summaries" data-news-search-input />
    </label>
    <div class="news-filter-row" role="group" aria-label="Filter news by category">
      <button class="status-filter-button" type="button" data-news-filter="all" aria-pressed="true">All</button>
      {categories.map((category) => (
        <button class="status-filter-button" type="button" data-news-filter={category} aria-pressed="false">{category}</button>
      ))}
    </div>
    <p class="news-tools-links"><a class="cta" href="/news/rss.xml">News RSS</a> · <a class="cta" href="/updates/">Website changelog</a></p>
  </section>

  <section class="news-index-list" aria-label="Project news">
    {newsEntries.map(({ data, path }) => (
      <NewsEntry date={data.dateLabel} title={data.title} description={data.description} href={path} category={data.category} ctaLabel={`Read ${data.title}`} />
    ))}
  </section>

  <div class="project-empty-state news-empty-state" data-news-empty-state hidden>
    <h3>No news items match that search.</h3>
    <p>Clear the search or select another category.</p>
  </div>

  <section class="content-card news-follow-card" aria-labelledby="news-follow-heading">
    <div>
      <p class="eyebrow">Publishing policy</p>
      <h2 id="news-follow-heading">No fixed update schedule</h2>
      <p>New notes are published only when a project status or maintenance decision materially changes. Historical release notes remain available for context.</p>
    </div>
    <div class="landing-actions">
      <a class="button-cta button-cta-secondary" href="/news/rss.xml">Open RSS feed</a>
      <a class="button-cta button-cta-secondary" href="/about/">About Made by Kreativ</a>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>
