---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="KREATIV Idea Library | Made by Kreativ"
  description="Your First Digital Product has been replaced in the current journey by the free KREATIV Idea Library."
  canonicalPath="/product-to-profit/idea-library/"
  robots="noindex,follow"
  redirectTo="/product-to-profit/idea-library/"
>
  <section class="redirect-page" aria-labelledby="redirect-heading">
    <img src="/product-to-profit/covers/idea-library.png" width="320" height="180" alt="KREATIV Idea Library cover" />
    <p class="eyebrow">Current Explore stage</p>
    <h1 id="redirect-heading">Continue with the KREATIV Idea Library.</h1>
    <p>The earlier guide is no longer the primary product path. The Idea Library now hands a shortlist into the Product Idea Scorecard.</p>
    <a class="button-cta button-cta-primary" href="/product-to-profit/idea-library/">Open the Idea Library page</a>
  </section>
  <script is:inline>window.location.replace("/product-to-profit/idea-library/" + window.location.search + window.location.hash);</script>
</BaseLayout>
