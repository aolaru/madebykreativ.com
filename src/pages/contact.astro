---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import HeroHeader from "../components/HeroHeader.astro";
import ProjectInquiry from "../components/ProjectInquiry.astro";
import PublicEmail from "../components/PublicEmail.astro";
import { buildUrl, communityProjects, contactPageSchema, createBreadcrumbSchema, organizationSchema, projectPath, site } from "../data/site";
---

<BaseLayout
  title="Contact | Made by Kreativ"
  description="Contact Andrei Olaru for selected software development and QA projects, app support, product purchases, licensing or public project feedback."
  canonicalPath="/contact/"
  ogImage={buildUrl("/og-contact.png")}
  ogImageAlt="Made by Kreativ contact card."
  structuredData={[
    organizationSchema,
    contactPageSchema,
    createBreadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Contact", path: "/contact/" }
    ])
  ]}
>
  <HeroHeader
    current="contact"
    eyebrow="Get in touch"
    title="Contact"
    tagline="Let's discuss what you need built, fixed or tested."
  />

  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Contact" }]} />

  <ProjectInquiry />

  <section class="content-card contact-email-card" aria-labelledby="email-heading">
    <p class="eyebrow">Product support and general questions</p>
    <h2 id="email-heading">Need help with an existing product?</h2>
    <p>Use <PublicEmail class="cta" /> for purchase access, app issues, licensing, or a question that cannot be handled in a public repository.</p>
    <p>Include the product name and relevant details. Please keep passwords and payment information out of your message.</p>
    <div class="contact-copy-row">
      <code><PublicEmail /></code>
      <button class="button-cta button-cta-secondary" type="button" data-copy-email={site.email}>Copy email address</button>
      <span class="copy-status" data-copy-status aria-live="polite"></span>
    </div>
  </section>

  <section class="ptp-section" aria-labelledby="app-support-heading">
    <h2 id="app-support-heading">Help with an Android app</h2>
    <p>Include the app and Android versions, your phone model, and the steps that reproduce the issue.</p>
    <p><a class="cta" href="/apps/support/">Prepare an app support report</a></p>
  </section>

  <section class="contact-intents standalone-section" aria-labelledby="project-feedback-heading">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Public repositories</p>
        <h2 id="project-feedback-heading">Project feedback belongs with the code</h2>
        <p>Use GitHub Issues for reproducible bugs, documentation corrections, and small compatibility improvements.</p>
      </div>
    </div>
    <div class="contact-grid">
      {communityProjects.map((project) => (
        <article class="contact-option">
          <span class="pillar-status">{project.status}</span>
          <h3>{project.label}</h3>
          <p>{project.description}</p>
          <div class="project-actions">
            <a class="cta" href={projectPath(project.slug)}>Overview</a>
            {project.sourceHref && <a class="cta" href={`${project.sourceHref}/issues`} target="_blank" rel="noopener">GitHub Issues</a>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="response-guide standalone-section" aria-labelledby="availability-heading">
    <h2 id="availability-heading">Availability</h2>
    <dl class="response-guide-list">
      <div>
        <dt>Existing purchases</dt>
        <dd>Email the purchase address and product name. Do not include payment details.</dd>
      </div>
      <div>
        <dt>Open-source projects</dt>
        <dd>Issues and focused pull requests are welcome, but review and merge timing are not guaranteed.</dd>
      </div>
      <div>
        <dt>New engagements</dt>
        <dd>Selected, fixed-scope development and QA projects are considered subject to fit and availability. Scope, communication, acceptance and handover are agreed in the proposal. Response times and ongoing support are not guaranteed.</dd>
      </div>
    </dl>
  </section>

</BaseLayout>
