---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import HeroHeader from "../components/HeroHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { buildUrl, contactPageSchema, createBreadcrumbSchema, organizationSchema, projectPath, publicProjects, site } from "../data/site";
---

<BaseLayout
  title="Contact | Made by Kreativ"
  description="Contact Andrei Olaru about existing Made by Kreativ purchases, licensing, or public project repositories. Replies are best effort."
  canonicalPath="/contact/"
  ogImage={buildUrl("/og-contact.png")}
  ogImageAlt="Made by Kreativ contact card."
  structuredData={[
    organizationSchema,
    contactPageSchema,
    createBreadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Contact", path: "/contact/" }
    ])
  ]}
>
  <HeroHeader
    current="contact"
    eyebrow="Limited contact"
    title="Contact"
    tagline="For existing purchases, licensing questions, and focused project feedback."
  />

  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Contact" }]} />

  <section class="content-card contact-email-card" aria-labelledby="email-heading">
    <p class="eyebrow">Best-effort replies</p>
    <h2 id="email-heading">Email</h2>
    <p>Use <a class="cta" href={`mailto:${site.email}`}>{site.email}</a> for purchase access, licensing, or a concise question that cannot be handled in a public repository.</p>
    <p>Made by Kreativ is semi-retired. Messages are reviewed when time allows, and no response time is guaranteed.</p>
    <div class="contact-copy-row">
      <code>{site.email}</code>
      <button class="button-cta button-cta-secondary" type="button" data-copy-email={site.email}>Copy email address</button>
      <span class="copy-status" data-copy-status aria-live="polite"></span>
    </div>
  </section>

  <section class="contact-intents standalone-section" aria-labelledby="project-feedback-heading">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Public repositories</p>
        <h2 id="project-feedback-heading">Project feedback belongs with the code</h2>
        <p>Use GitHub Issues for reproducible bugs, documentation corrections, and small compatibility improvements.</p>
      </div>
    </div>
    <div class="contact-grid">
      {publicProjects.map((project) => (
        <article class="contact-option">
          <span class="pillar-status">{project.status}</span>
          <h3>{project.label}</h3>
          <p>{project.description}</p>
          <div class="project-actions">
            <a class="cta" href={projectPath(project.slug)}>Overview</a>
            {project.sourceHref && <a class="cta" href={`${project.sourceHref}/issues`} target="_blank" rel="noopener">GitHub Issues</a>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="response-guide standalone-section" aria-labelledby="availability-heading">
    <h2 id="availability-heading">Availability</h2>
    <dl class="response-guide-list">
      <div>
        <dt>Existing purchases</dt>
        <dd>Email the purchase address and product name. Do not include payment details.</dd>
      </div>
      <div>
        <dt>Open-source projects</dt>
        <dd>Issues and focused pull requests are welcome, but review and merge timing are not guaranteed.</dd>
      </div>
      <div>
        <dt>New engagements</dt>
        <dd>Ongoing support contracts, retainers, and active product partnerships are not currently offered.</dd>
      </div>
    </dl>
  </section>

  <SiteFooter />
</BaseLayout>
