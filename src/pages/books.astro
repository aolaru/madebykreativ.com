---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Guides & Toolkits | Made by Kreativ"
  description="Made by Kreativ books have moved to the Guides & Toolkits collection."
  canonicalPath="/guides/"
  robots="noindex,follow"
>
  <section class="redirect-page" aria-labelledby="redirect-heading">
    <img src="/favicon.svg" width="52" height="52" alt="" />
    <p class="eyebrow">Updated collection</p>
    <h1 id="redirect-heading">Books are now Guides & Toolkits.</h1>
    <p>The collection has a clearer name and a new address.</p>
    <a class="button-cta button-cta-primary" href="/guides/">Open Guides & Toolkits</a>
  </section>
  <script is:inline>window.location.replace("/guides/");</script>
</BaseLayout>
