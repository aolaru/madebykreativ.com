---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Product-to-Profit | Made by Kreativ"
  description="Made by Kreativ books and guides have moved into the KREATIV Product-to-Profit System."
  canonicalPath="/product-to-profit/"
  robots="noindex,follow"
>
  <section class="redirect-page" aria-labelledby="redirect-heading">
    <img src="/favicon.svg" width="52" height="52" alt="" />
    <p class="eyebrow">Updated collection</p>
    <h1 id="redirect-heading">Books are now Product-to-Profit.</h1>
    <p>Explore the current decision system and start at the stage that matches your existing input.</p>
    <a class="button-cta button-cta-primary" href="/product-to-profit/">Open Product-to-Profit</a>
  </section>
  <script is:inline>window.location.replace("/product-to-profit/");</script>
</BaseLayout>
