---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import QuoteLink from "../components/QuoteLink.astro";
import EngagementPackages from "../components/EngagementPackages.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import InquiryTools from "../components/InquiryTools.astro";
import { caseStudies } from "../data/caseStudies";
import {
  buildUrl,
  createBreadcrumbSchema,
  createPageSchema,
  organizationSchema,
} from "../data/site";
import {
  services,
  servicesDescription,
  servicesSchema,
  formatServicePrice,
  projectProcess,
} from "../data/services";
const pageTitle = "Software Development Services | Made by KREATIV";
---

<BaseLayout
  title={pageTitle}
  description={servicesDescription}
  canonicalPath="/services/"
  ogImage={buildUrl("/og-services.png")}
  ogImageAlt="Made by KREATIV software development and quality engineering, illustrated with real WordPress and Android product screenshots."
  structuredData={[
    organizationSchema,
    createPageSchema({
      name: pageTitle,
      description: servicesDescription,
      path: "/services/",
    }),
    createBreadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Services", path: "/services/" },
    ]),
    servicesSchema,
  ]}
>
  <header class="services-hero">
    <p class="eyebrow">Made by KREATIV · Independent development</p>
    <h1>
      Custom Software.
      <br />
      Built and Tested.
    </h1>
    <p class="services-intro">
      From WordPress plugins and Chrome extensions to mobile apps and API
      automation, Made by KREATIV helps turn practical ideas into reliable
      software.
    </p>
    <div class="landing-actions">
      <QuoteLink />
      <a class="button-cta button-cta-secondary" href="/work/">
        Explore My Work
      </a>
    </div>
    <p class="services-hero-note">
      Andrei Olaru · Around 15 years in professional software QA
    </p>
  </header>

  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Services" }]} />

  <nav class="client-section-nav" aria-label="Services sections">
    <a href="#starting-packages">Starting packages</a>
    <a href="#services-heading">All services</a>
    <a href="#service-case-studies">Case studies</a>
    <a href="#process-heading">Process</a>
    <a href="/contact/#project-inquiry">Project inquiry</a>
  </nav>

  <section
    class="services-section"
    id="starting-packages"
    aria-labelledby="starting-packages-heading"
  >
    <p class="eyebrow">Defined scope, tangible deliverables</p>
    <h2 id="starting-packages-heading">Choose a starting point</h2>
    <EngagementPackages compact />
    <p class="services-price-note">
      Indicative EUR starting prices. Follow Scope and details for inputs,
      deliverables and exclusions; the final proposal defines the agreed work.
    </p>
  </section>

  <section class="services-section" aria-labelledby="services-heading">
    <div class="services-section-heading">
      <p class="eyebrow">Focused engagements</p>
      <h2 id="services-heading">A clear scope. Something useful delivered.</h2>
      <p>
        Independent software development and quality engineering for businesses,
        startups and creators. Small and medium-sized projects are reviewed
        individually for fit and availability.
      </p>
    </div>
    <div class="service-offerings">
      {services.map((service) => (
        <article
          class="service-offering"
          id={service.id}
          aria-labelledby={`${service.id}-heading`}
        >
          <h3 id={`${service.id}-heading`}>{service.name}</h3>
          <p class="service-summary">{service.summary}</p>
          <details class="service-capability-details">
            <summary>Capabilities and scope</summary>
            <ul class="service-capabilities">
              {service.capabilities.map((capability) => (
                <li>{capability}</li>
              ))}
            </ul>
            <p class="service-scope">{service.scope}</p>
          </details>
          <dl class="service-prices">
            {service.prices.length ? (
              service.prices.map((price) => (
                <div>
                  <dt>{price.label}</dt>
                  <dd>
                    from <strong>{formatServicePrice(price.from)}</strong>
                  </dd>
                </div>
              ))
            ) : (
              <div>
                <dt>Project pricing</dt>
                <dd>
                  <strong>Custom quote</strong>
                </dd>
              </div>
            )}
          </dl>
          {(service.id === "wordpress" || service.id === "software-qa") && (
            <a
              class="cta"
              href={`/services/${service.id === "wordpress" ? "wordpress" : "qa-api-testing"}/`}
            >
              Detailed service scope
            </a>
          )}
        </article>
      ))}
    </div>
    <p class="services-price-note">
      <strong>Indicative starting prices, in EUR, not fixed quotes.</strong> The
      final price depends on scope, complexity, integrations and delivery
      requirements. A fixed-price engagement starts with an agreed proposal; the
      starting price does not cover a full-featured mobile app or complex
      software platform.
    </p>
  </section>

  <section
    class="services-section"
    id="service-case-studies"
    aria-labelledby="service-case-heading"
  >
    <p class="eyebrow">Independent work, inspectable evidence</p>
    <h2 id="service-case-heading">The decisions behind the work</h2>
    <div class="case-grid">
      {caseStudies.slice(0, 2).map((study) => (
        <CaseStudyCard study={study} />
      ))}
    </div>
    <p class="services-related">
      <a class="cta" href="/work/">
        All case studies and published software
      </a>
      <a class="cta" href="/work/api-automation-demo/">
        Run the API testing demonstration
      </a>
    </p>
  </section>

  <section class="services-section" aria-labelledby="process-heading">
    <div class="services-section-heading">
      <p class="eyebrow">From the first brief to handover</p>
      <h2 id="process-heading">How it works</h2>
    </div>
    <ol class="services-process">
      {projectProcess.map((step, index) => (
        <li>
          <span aria-hidden="true">0{index + 1}</span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </li>
      ))}
    </ol>
    <p class="services-price-note">
      Timing, testing, acceptance criteria and handover are agreed for each
      project. No guaranteed turnaround or ongoing retainer is implied.
    </p>
  </section>

  <section
    class="services-project-cta"
    aria-labelledby="project-inquiry-heading"
  >
    <p class="eyebrow">A practical next step</p>
    <h2 id="project-inquiry-heading">Have a project in mind?</h2>
    <p>
      Tell me what you want to build or improve, and I'll review whether it's a
      good fit.
    </p>
    <div class="landing-actions">
      <QuoteLink />
      <a class="cta" href="/contact/#project-inquiry">
        Project inquiry details
      </a>
    </div>
    <InquiryTools id="services-inquiry" />
  </section>
</BaseLayout>
