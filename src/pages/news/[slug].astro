---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import HeroHeader from "../../components/HeroHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { buildUrl, createBreadcrumbSchema, createNewsArticleSchema, organizationSchema, projectDirectory, projectPath, site } from "../../data/site";

const newsPath = (id: string) => `/news/${id.replace(/\.md$/, "")}/`;

export async function getStaticPaths() {
  const entries = (await getCollection("news"))
    .sort((a, b) => b.data.sortDate.valueOf() - a.data.sortDate.valueOf());

  return entries.map((entry, index) => ({
    params: { slug: entry.id.replace(/\.md$/, "") },
    props: {
      entry,
      newerEntry: entries[index - 1],
      olderEntry: entries[index + 1]
    }
  }));
}

const { entry, newerEntry, olderEntry } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id.replace(/\.md$/, "");
const canonicalPath = `/news/${slug}/`;
const publishedTime = entry.data.sortDate.toISOString();
const modifiedTime = new Date(`${site.lastUpdated}T00:00:00.000Z`).toISOString();
const articleSchema = createNewsArticleSchema({
  title: entry.data.title,
  description: entry.data.description,
  path: canonicalPath,
  datePublished: entry.data.sortDate,
  dateModified: new Date(modifiedTime)
});
const relatedProject = entry.data.project
  ? projectDirectory.find((project) => project.slug === entry.data.project)
  : undefined;
const articleImage = entry.data.image || relatedProject?.preview;
const articleImageAlt = relatedProject?.previewAlt || `${entry.data.title} product preview.`;
const isHistoricalUpdate = entry.data.sortDate.valueOf() < new Date("2026-08-20T00:00:00.000Z").valueOf();
---

<BaseLayout
  title={`${entry.data.title} | Made by Kreativ`}
  description={entry.data.description}
  canonicalPath={canonicalPath}
  ogType="article"
  ogTitle={`${entry.data.title} | Made by Kreativ`}
  ogDescription={entry.data.description}
  ogImage={buildUrl("/og-news.png")}
  ogImageAlt="Made by Kreativ project update card."
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  structuredData={[
    organizationSchema,
    articleSchema,
    createBreadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Updates", path: "/news/" },
      { name: entry.data.title, path: canonicalPath }
    ])
  ]}
>
  <HeroHeader
    current="news"
    eyebrow="Update"
    title={entry.data.title}
    tagline={entry.data.description}
  >
    <p slot="afterTagline" class="meta-note">{entry.data.dateLabel} · {entry.data.category}</p>
  </HeroHeader>

  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Updates", href: "/news/" }, { label: entry.data.title }]} />

  <article class="content-card news-detail">
    <dl class="article-fact-list">
      <div>
        <dt>Published</dt>
        <dd>{entry.data.dateLabel}</dd>
      </div>
      <div>
        <dt>Category</dt>
        <dd>{entry.data.category}</dd>
      </div>
      <div>
        <dt>Related surface</dt>
        <dd>{relatedProject ? relatedProject.label : "Made by Kreativ"}</dd>
      </div>
    </dl>
    {isHistoricalUpdate && (
      <p class="article-archive-note"><strong>Historical update.</strong> This article predates the August 2026 handoff that opened three projects to contributors. The project directory shows the current status.</p>
    )}
    {articleImage && (
      <figure class:list={["article-preview", !relatedProject && "article-preview-portrait"]}>
        <img src={articleImage} alt={articleImageAlt} width={relatedProject ? "1200" : "1191"} height={relatedProject ? "750" : "1684"} loading="eager" />
        <figcaption>{relatedProject ? `Current ${relatedProject.label} public surface, verified ${relatedProject.updated}.` : "Current product cover and visual direction."}</figcaption>
      </figure>
    )}
    <Content />
    <aside class="article-next-step" aria-labelledby="article-next-step-heading">
      <div>
        <p class="eyebrow">Continue from here</p>
        <h2 id="article-next-step-heading">{relatedProject ? `Explore ${relatedProject.label}` : "Explore the related product path"}</h2>
        <p>{relatedProject ? relatedProject.description : "See the current guides, toolkits, and project surfaces connected to this update."}</p>
      </div>
      <div class="landing-actions">
        {relatedProject && <a class="button-cta button-cta-primary" href={projectPath(relatedProject.slug)}>Project details</a>}
        {!relatedProject && <a class="button-cta button-cta-primary" href="/product-to-profit/">Product-to-Profit</a>}
        <a class="button-cta button-cta-secondary" href="/news/rss.xml">Updates RSS</a>
      </div>
    </aside>
    <nav class="article-nav" aria-label="Update navigation">
      <a class="cta" href="/news/">Back to Updates</a>
      <div class="article-nav-pair">
        {newerEntry && <a class="cta" href={newsPath(newerEntry.id)}>Newer: {newerEntry.data.title}</a>}
        {olderEntry && <a class="cta" href={newsPath(olderEntry.id)}>Older: {olderEntry.data.title}</a>}
      </div>
    </nav>
  </article>

  <SiteFooter />
</BaseLayout>
