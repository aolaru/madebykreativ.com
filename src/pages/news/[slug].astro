---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import HeroHeader from "../../components/HeroHeader.astro";
import { apps } from "../../data/apps";
import RelatedApps from "../../components/RelatedApps.astro";
import {lastModified} from "../../data/modified";
import { buildUrl, createBreadcrumbSchema, createNewsArticleSchema, organizationSchema, projectDirectory, projectPath, site } from "../../data/site";

const newsPath = (id: string) => `/news/${id.replace(/\.md$/, "")}/`;

export async function getStaticPaths() {
  const entries = (await getCollection("news"))
    .sort((a, b) => b.data.sortDate.valueOf() - a.data.sortDate.valueOf());

  return entries.map((entry, index) => ({
    params: { slug: entry.id.replace(/\.md$/, "") },
    props: {
      entry,
      newerEntry: entries[index - 1],
      olderEntry: entries[index + 1]
    }
  }));
}

const { entry, newerEntry, olderEntry } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id.replace(/\.md$/, "");
const canonicalPath = `/news/${slug}/`;
const publishedTime = entry.data.sortDate.toISOString();
const modifiedTime = entry.data.modifiedDate?.toISOString() || `${lastModified([`src/content/news/${slug}.md`], publishedTime.slice(0, 10))}T00:00:00.000Z`;
const articleSchema = createNewsArticleSchema({
  title: entry.data.title,
  description: entry.data.description,
  path: canonicalPath,
  datePublished: entry.data.sortDate,
  dateModified: new Date(modifiedTime)
});
const relatedProject = entry.data.project
  ? projectDirectory.find((project) => project.slug === entry.data.project)
  : undefined;
const relatedApp = apps.find((app) => app.slug === entry.data.app);
const articleImage = entry.data.image || relatedProject?.preview;
const articleImageAlt = relatedProject?.previewAlt || `${entry.data.title} product preview.`;
const socialImage = relatedApp ? `/apps/${relatedApp.slug}/social.png` : slug === "ai-launch-toolkit-gumroad"
  ? "/og-ai-launch-toolkit.png"
  : articleImage || "/og-news.png";
const socialImageHeight = relatedProject?.preview && !entry.data.image ? "750" : "630";
const isHistoricalUpdate = entry.data.sortDate.valueOf() < new Date("2026-10-04T00:00:00.000Z").valueOf();
---

<BaseLayout
  title={relatedApp ? entry.data.title : `${entry.data.title} | Made by Kreativ`}
  description={entry.data.description}
  canonicalPath={canonicalPath}
  ogType="article"
  ogTitle={`${entry.data.title} | Made by Kreativ`}
  ogDescription={entry.data.description}
  ogImage={buildUrl(socialImage)}
  ogImageAlt={articleImage ? articleImageAlt : `Made by Kreativ news card for ${entry.data.title}.`}
  ogImageWidth="1200"
  ogImageHeight={socialImageHeight}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  structuredData={[
    organizationSchema,
    articleSchema,
    createBreadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Updates", path: "/updates/" },
      { name: entry.data.title, path: canonicalPath }
    ])
  ]}
>
  <HeroHeader
    current="news"
    eyebrow={relatedApp ? `${relatedApp.name} tutorial` : "Update"}
    title={entry.data.title}
    tagline={entry.data.description}
  >
    <p slot="afterTagline" class="meta-note">{entry.data.dateLabel} · {entry.data.category}</p>
  </HeroHeader>

  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Updates", href: "/updates/" }, { label: entry.data.title }]} />

  <article class:list={["content-card", "news-detail", relatedApp && "app-tutorial"]}>
    <dl class="article-fact-list">
      <div>
        <dt>Published</dt>
        <dd>{entry.data.dateLabel}</dd>
      </div>
      <div>
        <dt>Category</dt>
        <dd>{entry.data.category}</dd>
      </div>
      <div>
        <dt>Related surface</dt>
        <dd>{relatedApp?.name || relatedProject?.label || "Made by Kreativ"}</dd>
      </div>
    </dl>
    {isHistoricalUpdate && (
      <p class="article-archive-note"><strong>Historical update.</strong> Prices, releases, and status describe the publication date. See <a href="/product-to-profit/">current product details</a> and the <a href="/projects/">project directory</a> for the latest information.</p>
    )}
    {articleImage && (
      <figure class:list={["article-preview", !relatedProject && "article-preview-portrait"]}>
        <img src={articleImage} alt={articleImageAlt} width={relatedProject ? "1200" : "1191"} height={relatedProject ? "750" : "1684"} loading="eager" />
        <figcaption>{relatedProject ? `${relatedProject.label} reference screenshot from October 17, 2026; the live site may differ.` : "Product artwork; consult the product page for current release specifications."}</figcaption>
      </figure>
    )}
    <Content />
    <aside class="article-next-step" aria-labelledby="article-next-step-heading">
      <div>
        <p class="eyebrow">Continue from here</p>
        <h2 id="article-next-step-heading">{relatedApp ? `Explore ${relatedApp.name}` : relatedProject ? `Explore ${relatedProject.label}` : "Explore the related product path"}</h2>
        <p>{relatedApp?.description || relatedProject?.description || "See the current guides, toolkits, and project surfaces connected to this update."}</p>
      </div>
      <div class="landing-actions">
        {relatedApp && <a class="button-cta button-cta-primary" href={`/apps/${relatedApp.slug}/`}>{relatedApp.name} app details</a>}
        {!relatedApp && relatedProject && <a class="button-cta button-cta-primary" href={projectPath(relatedProject.slug)}>Project details</a>}
        {!relatedApp && !relatedProject && <a class="button-cta button-cta-primary" href="/product-to-profit/">Product-to-Profit</a>}
        <a class="button-cta button-cta-secondary" href="/updates/rss.xml">Updates RSS</a>
      </div>
    </aside>
    <nav class="article-nav" aria-label="Update navigation">
      <a class="cta" href="/updates/">Back to Updates</a>
      <div class="article-nav-pair">
        {newerEntry && <a class="cta" href={newsPath(newerEntry.id)}>Newer: {newerEntry.data.title}</a>}
        {olderEntry && <a class="cta" href={newsPath(olderEntry.id)}>Older: {olderEntry.data.title}</a>}
      </div>
    </nav>
  </article>

  {relatedApp && <RelatedApps slug={relatedApp.slug} />}
</BaseLayout>
