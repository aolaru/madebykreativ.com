---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import HeroHeader from "../components/HeroHeader.astro";
import QuoteLink from "../components/QuoteLink.astro";
import PublicEmail from "../components/PublicEmail.astro";
import { professionalSkills } from "../data/services";
import {
  buildUrl,
  createBreadcrumbSchema,
  createPageSchema,
  organizationSchema,
} from "../data/site";

const pageDescription =
  "Meet Andrei Olaru: independent developer and experienced software QA professional. Made by KREATIV combines digital products, software development and quality engineering.";
---

<BaseLayout
  title="About | Made by Kreativ"
  description={pageDescription}
  canonicalPath="/about/"
  ogImage={buildUrl("/og-about.png")}
  ogImageAlt="Made by Kreativ about page card for the independent product ecosystem."
  structuredData={[
    organizationSchema,
    createPageSchema({
      type: "AboutPage",
      name: "About | Made by Kreativ",
      description: pageDescription,
      path: "/about/",
    }),
    createBreadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "About", path: "/about/" },
    ]),
  ]}
>
  <HeroHeader
    current="about"
    eyebrow="Your independent developer and QA professional"
    title="About Made by Kreativ"
    tagline="Independent digital products, software development and quality engineering by Andrei Olaru."
  />

  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "About" }]} />

  <section
    class="content-card founder-profile"
    aria-labelledby="founder-heading"
  >
    <div class="founder-mark" aria-hidden="true">
      <span>AO</span>
    </div>
    <div class="founder-copy">
      <p class="eyebrow">Direct collaboration</p>
      <h2 id="founder-heading">Built by Andrei Olaru</h2>
      <p>
        Made by Kreativ is Andrei Olaru's independent studio, combining
        practical digital products, software development and professional
        software quality engineering.
      </p>
      <p>
        I work directly with small teams on clearly scoped development and QA
        projects. My independently published software provides practical
        examples of the work, alongside around 15 years of professional software
        QA experience.
      </p>
      <p>
        My QA background includes enterprise web applications and API testing.
        I bring that experience to defining test coverage, investigating defects
        and communicating release risks, alongside independently built software.
      </p>
      <p>
        Based in Bucharest, Romania (Europe/Bucharest). You work directly with
        me, from the first technical discussion through handover.
      </p>
      <p>
        <a
          class="cta"
          href="https://github.com/aolaru"
          target="_blank"
          rel="noopener"
        >
          Public GitHub profile and source code
        </a>{" "}
        ·{" "}
        <a class="cta" href="/work/">
          Published work and testing evidence
        </a>
      </p>
      <p>
        Made by KREATIV remains active, and I maintain Kreativ Tools again.
        Findsera and News Ledger remain open to contributors because I no longer
        maintain those projects. Kreativ Auto is currently paused.
      </p>
      <div class="landing-actions founder-actions">
        <a
          class="button-cta button-cta-primary"
          href="/contact/#project-inquiry"
        >
          Discuss Your Project
        </a>
        <a class="button-cta button-cta-secondary" href="/work/">
          Read case studies
        </a>
      </div>
      <p>Prefer email? <PublicEmail /></p>
    </div>
  </section>

  <section class="services-section" aria-labelledby="professional-heading">
    <p class="eyebrow">Development and QA expertise together</p>
    <h2 id="professional-heading">
      Professional experience, practical software
    </h2>
    <div class="services-principles services-skills">
      {professionalSkills.map((item) => (
        <article>
          <h3>{item.title}</h3>
          <p>{item.skills}</p>
        </article>
      ))}
    </div>
    <p class="services-related">
      Selected, fixed-scope development and QA projects are considered
      individually, subject to fit and availability.
    </p>
    <div class="landing-actions">
      <a class="button-cta button-cta-secondary" href="/services/">
        Explore Development Services
      </a>
      <QuoteLink />
    </div>
  </section>
  <section class="services-section" aria-labelledby="working-together-heading">
    <p class="eyebrow">What happens next</p>
    <h2 id="working-together-heading">A clear decision before work begins</h2>
    <ol class="services-process">
      <li>
        <h3>Fit and questions</h3>
        <p>
          I review the problem and ask for the missing technical context. An
          inquiry is not a commitment to start.
        </p>
      </li>
      <li>
        <h3>Scope and schedule</h3>
        <p>
          We agree deliverables, acceptance checks, communication, a proposed
          schedule and the quotation before implementation.
        </p>
      </li>
      <li>
        <h3>Changes and handover</h3>
        <p>
          Scope changes are discussed before extra work. Included retests,
          source delivery and any future support are explicit in the proposal.
        </p>
      </li>
    </ol>
    <p class="services-price-note">
      Availability, milestones and communication are confirmed for each project
      in the proposal.
    </p>
  </section>

  <section class="services-section" aria-labelledby="projects-heading">
    <h2 id="projects-heading">Independent projects</h2>
    <p>Explore the active products and contributor handoffs, with their current maintenance status.</p>
    <a class="cta" href="/projects/">Explore the project directory</a>
  </section>
</BaseLayout>
