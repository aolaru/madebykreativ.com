---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import HeroHeader from "../components/HeroHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { buildUrl, communityProjects, createBreadcrumbSchema, createPageSchema, organizationSchema, projectPath } from "../data/site";

const pageDescription = "Learn about Made by Kreativ, Andrei Olaru's active independent product studio, its current products, and open-source contributor projects.";
---

<BaseLayout
  title="About | Made by Kreativ"
  description={pageDescription}
  canonicalPath="/about/"
  ogImage={buildUrl("/og-about.png")}
  ogImageAlt="Made by Kreativ about page card for the independent product ecosystem."
  structuredData={[
    organizationSchema,
    createPageSchema({
      type: "AboutPage",
      name: "About | Made by Kreativ",
      description: pageDescription,
      path: "/about/"
    }),
    createBreadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "About", path: "/about/" }
    ])
  ]}
>
  <HeroHeader
    current="about"
    eyebrow="Independent work"
    title="About Made by Kreativ"
    tagline="An active independent studio for practical products, public source projects, and useful digital work."
  />

  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "About" }]} />

  <section class="content-card founder-profile" aria-labelledby="founder-heading">
    <div class="founder-mark" aria-hidden="true">
      <span>AO</span>
    </div>
    <div class="founder-copy">
      <p class="eyebrow">Independent builder</p>
      <h2 id="founder-heading">Built by Andrei Olaru</h2>
      <p>Made by Kreativ brings together independent products and experiments created across design, development, publishing, and practical software.</p>
      <p>Made by KREATIV remains active. Product-to-Profit and future independent work continue here, while Kreativ Tools, Findsera, and News Ledger have been opened to contributors because I no longer maintain those three projects.</p>
      <div class="landing-actions founder-actions">
        <a class="button-cta button-cta-primary" href="/product-to-profit/">Explore current work</a>
        <a class="button-cta button-cta-secondary" href="/news/">Read status updates</a>
      </div>
    </div>
  </section>

  <section class="content-card landing-section" aria-labelledby="principles-heading">
    <p class="eyebrow">Portfolio approach</p>
    <h2 id="principles-heading">How the work is managed</h2>
    <div class="about-principle-grid">
      <article>
        <span>01</span>
        <h3>Active product work</h3>
        <p>Made by KREATIV continues to develop focused products and practical systems, including Product-to-Profit.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Community handoff</h3>
        <p>Three projects are no longer maintained by Andrei, so their source is public for contributors to inspect, fork, and improve.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Clear project status</h3>
        <p>Active work and contributor projects are presented separately, so ownership and maintenance expectations stay clear.</p>
      </article>
    </div>
  </section>

  <section class="content-card landing-section" aria-labelledby="scope-heading">
    <p class="eyebrow">Open-source handoff</p>
    <h2 id="scope-heading">Projects open to contributors</h2>
    <div class="about-principle-grid about-public-grid">
      {communityProjects.map((project) => (
        <article>
          <span class="pillar-status">{project.status}</span>
          <h3>{project.label}</h3>
          <p>{project.description}</p>
          <a class="cta" href={projectPath(project.slug)}>Project overview</a>
        </article>
      ))}
    </div>
  </section>

  <section class="content-card landing-section" aria-labelledby="timeline-heading">
    <p class="eyebrow">Selected milestones</p>
    <h2 id="timeline-heading">How the project family evolved</h2>
    <ol class="about-timeline">
      <li>
        <time datetime="2026-03">March 2026</time>
        <div>
          <h3>The project family was organized</h3>
          <p>Independent tools, creative resources, and guides gained a shared Made by Kreativ home.</p>
        </div>
      </li>
      <li>
        <time datetime="2026-05">May 2026</time>
        <div>
          <h3>The wider archive took shape</h3>
          <p>Project profiles and release notes made the body of work easier to understand and preserve.</p>
        </div>
      </li>
      <li>
        <time datetime="2026-08">August 2026</time>
        <div>
          <h3>Three projects opened to contributors</h3>
          <p>Kreativ Tools, Findsera, and News Ledger were opened to contributors while Made by KREATIV continued its active product work.</p>
        </div>
      </li>
    </ol>
  </section>

  <SiteFooter />
</BaseLayout>
