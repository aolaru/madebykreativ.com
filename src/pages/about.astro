---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import HeroHeader from "../components/HeroHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { buildUrl, createBreadcrumbSchema, createPageSchema, organizationSchema, projectPath, publicProjects } from "../data/site";

const pageDescription = "Learn about Made by Kreativ, Andrei Olaru's semi-retired collection of maintained tools, open-source projects, practical guides, and past work.";
---

<BaseLayout
  title="About | Made by Kreativ"
  description={pageDescription}
  canonicalPath="/about/"
  ogImage={buildUrl("/og-about.png")}
  ogImageAlt="Made by Kreativ about page card for the independent product ecosystem."
  structuredData={[
    organizationSchema,
    createPageSchema({
      type: "AboutPage",
      name: "About | Made by Kreativ",
      description: pageDescription,
      path: "/about/"
    }),
    createBreadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "About", path: "/about/" }
    ])
  ]}
>
  <HeroHeader
    current="about"
    eyebrow="Independent work"
    title="About Made by Kreativ"
    tagline="A semi-retired collection of useful tools, public source projects, practical guides, and past work."
  />

  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "About" }]} />

  <section class="content-card founder-profile" aria-labelledby="founder-heading">
    <div class="founder-mark" aria-hidden="true">
      <span>AO</span>
    </div>
    <div class="founder-copy">
      <p class="eyebrow">Independent builder</p>
      <h2 id="founder-heading">Built by Andrei Olaru</h2>
      <p>Made by Kreativ brings together independent products and experiments created across design, development, publishing, and practical software.</p>
      <p>I am semi-retired from active product development. A small number of projects remain public, maintenance is selective, and earlier work is preserved as an honest portfolio archive.</p>
      <div class="landing-actions founder-actions">
        <a class="button-cta button-cta-primary" href="/projects/">Explore the project archive</a>
        <a class="button-cta button-cta-secondary" href="/news/">Read status updates</a>
      </div>
    </div>
  </section>

  <section class="content-card landing-section" aria-labelledby="principles-heading">
    <p class="eyebrow">Current approach</p>
    <h2 id="principles-heading">What semi-retired means here</h2>
    <div class="about-principle-grid">
      <article>
        <span>01</span>
        <h3>Selective maintenance</h3>
        <p>Stable public tools may receive small fixes, compatibility updates, and accessibility improvements.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Source over promises</h3>
        <p>Reusable projects are published with source code instead of being presented as active future businesses.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Honest archives</h3>
        <p>Past projects remain documented without implying an active roadmap or regular publishing schedule.</p>
      </article>
    </div>
  </section>

  <section class="content-card landing-section" aria-labelledby="scope-heading">
    <p class="eyebrow">Public and reusable</p>
    <h2 id="scope-heading">What remains public</h2>
    <div class="about-principle-grid about-public-grid">
      {publicProjects.map((project) => (
        <article>
          <span class="pillar-status">{project.status}</span>
          <h3>{project.label}</h3>
          <p>{project.description}</p>
          <a class="cta" href={projectPath(project.slug)}>Project overview</a>
        </article>
      ))}
    </div>
  </section>

  <section class="content-card landing-section" aria-labelledby="timeline-heading">
    <p class="eyebrow">Selected milestones</p>
    <h2 id="timeline-heading">From active studio to public archive</h2>
    <ol class="about-timeline">
      <li>
        <time datetime="2026-03">March 2026</time>
        <div>
          <h3>The project family was organized</h3>
          <p>Independent tools, creative resources, and guides gained a shared Made by Kreativ home.</p>
        </div>
      </li>
      <li>
        <time datetime="2026-05">May 2026</time>
        <div>
          <h3>The wider archive took shape</h3>
          <p>Project profiles and release notes made the body of work easier to understand and preserve.</p>
        </div>
      </li>
      <li>
        <time datetime="2026-08">August 2026</time>
        <div>
          <h3>Maintenance and open-source transition</h3>
          <p>Kreativ Tools entered maintenance mode, while Findsera and News Ledger were preserved as public source archives.</p>
        </div>
      </li>
    </ol>
  </section>

  <SiteFooter />
</BaseLayout>
