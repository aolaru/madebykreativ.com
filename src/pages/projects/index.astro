---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import HeroHeader from "../../components/HeroHeader.astro";
import ProjectDirectoryCard from "../../components/ProjectDirectoryCard.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import {
  buildUrl,
  archivedProjects,
  ecosystemItemListSchema,
  organizationSchema,
  publicProjects,
  projectPath,
  statusDefinitions
} from "../../data/site";
---

<BaseLayout
  title="Projects | Made by Kreativ"
  description="Explore the maintained, open-source, and archived projects created by Andrei Olaru under Made by Kreativ."
  canonicalPath="/projects/"
  ogImage={buildUrl("/og-projects.png")}
  ogImageAlt="Made by Kreativ project directory card."
  structuredData={[organizationSchema, ecosystemItemListSchema]}
>
  <HeroHeader
    current="projects"
    eyebrow="Project archive"
    title="KREATIV Projects"
    tagline="Public repositories, maintained tools, and selected past work in one honest directory."
  />

  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Projects" }]} />

  <section class="project-map project-directory-page" aria-labelledby="project-map-heading">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Current public work</p>
        <h2 id="project-map-heading">Public and reusable</h2>
        <p>These projects remain available as maintained tools or public source archives.</p>
      </div>
      <a class="cta" href="/">Back to home</a>
    </div>

    <div class="project-directory-grid project-directory-grid-public">
      {publicProjects.map((project) => (
        <ProjectDirectoryCard
          href={projectPath(project.slug)}
          slug={project.slug}
          label={project.label}
          category={project.category}
          status={project.status}
          description={project.description}
          logo={project.logo}
        />
      ))}
    </div>

    <div class="section-heading-row directory-group-heading" id="past-work">
      <div>
        <p class="eyebrow">Portfolio archive</p>
        <h2>Selected past work</h2>
        <p>Public properties retained for reference, without an active development or publishing roadmap.</p>
      </div>
    </div>

    <div class="project-directory-grid project-directory-grid-archive">
      {archivedProjects.map((project) => (
        <ProjectDirectoryCard
          href={projectPath(project.slug)}
          slug={project.slug}
          label={project.label}
          category={project.category}
          status={project.status}
          description={project.description}
          logo={project.logo}
        />
      ))}
    </div>

    <dl class="status-legend project-status-reference">
      {statusDefinitions.map((status) => (
        <div>
          <dt>{status.label}</dt>
          <dd>{status.description}</dd>
        </div>
      ))}
    </dl>
  </section>

  <SiteFooter />
</BaseLayout>
