---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import HeroHeader from "../../components/HeroHeader.astro";
import ProjectDirectoryCard from "../../components/ProjectDirectoryCard.astro";
import AppLinks from "../../components/AppLinks.astro";
import {
  activeProjects,
  buildUrl,
  communityProjects,
  ecosystemItemListSchema,
  organizationSchema,
  projectPath,
  statusDefinitions,
  archivedProjects,
  pausedProjects
} from "../../data/site";
---

<BaseLayout
  title="Projects | Made by Kreativ"
  description="Explore active Made by Kreativ projects, paused references, and the open-source projects available to contributors."
  canonicalPath="/projects/"
  ogImage={buildUrl("/og-projects.png")}
  ogImageAlt="Made by Kreativ project directory card."
  structuredData={[organizationSchema, ecosystemItemListSchema]}
>
  <HeroHeader
    current="projects"
    eyebrow="Project directory"
    title="KREATIV Projects"
    tagline="Active independent projects, paused references and open-source contributor handoffs."
  />

  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Projects" }]} />

  <section class="project-map project-directory-page" aria-labelledby="project-map-heading">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Current work</p>
        <h2 id="project-map-heading">Active projects</h2>
        <p>Independent properties currently developed and maintained by Andrei under Made by KREATIV.</p>
      </div>
      <a class="cta" href="/">Back to home</a>
    </div>

    <div class="project-directory-grid project-directory-grid-public">
      {activeProjects.map((project) => (
        <ProjectDirectoryCard
          href={projectPath(project.slug)}
          slug={project.slug}
          label={project.label}
          category={project.category}
          status={project.status}
          description={project.description}
          logo={project.logo}
        />
      ))}
    </div>

    <div class="section-heading-row directory-group-heading" id="community-projects">
      <div>
        <p class="eyebrow">Open-source handoff</p>
        <h2>Open to contributors</h2>
        <p>Andrei no longer maintains these contributor projects. Their source remains public under the published licenses.</p>
      </div>
    </div>

    <div class="project-directory-grid project-directory-grid-archive">
      {communityProjects.map((project) => (
        <ProjectDirectoryCard
          href={projectPath(project.slug)}
          slug={project.slug}
          label={project.label}
          category={project.category}
          status={project.status}
          description={project.description}
          logo={project.logo}
        />
      ))}
    </div>

    {pausedProjects.length > 0 && <><div class="section-heading-row directory-group-heading"><div><p class="eyebrow">Not in active development</p><h2>Paused projects</h2></div></div><div class="project-directory-grid">{pausedProjects.map((project)=><ProjectDirectoryCard href={projectPath(project.slug)} slug={project.slug} label={project.label} category={project.category} status={project.status} description={project.description} logo={project.logo} />)}</div></>}
    <div class="section-heading-row directory-group-heading"><div><p class="eyebrow">Retained reference</p><h2>Archived projects</h2></div></div>
    <div class="project-directory-grid">{archivedProjects.map((project)=><ProjectDirectoryCard href={projectPath(project.slug)} slug={project.slug} label={project.label} category={project.category} status={project.status} description={project.description} logo={project.logo} />)}</div>
    <dl class="status-legend project-status-reference">
      {statusDefinitions.map((status) => (
        <div>
          <dt>{status.label}</dt>
          <dd>{status.description}</dd>
        </div>
      ))}
    </dl>
  </section>

  <AppLinks />
</BaseLayout>
