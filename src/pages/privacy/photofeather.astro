---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import HeroHeader from "../../components/HeroHeader.astro";
import { createBreadcrumbSchema, createPageSchema, organizationSchema } from "../../data/site";
import policy from "../../data/privacy/photofeather.txt?raw";

const pagePath = "/privacy/photofeather/";
const pageDescription = "PhotoFeather privacy policy: on-device photo compression and resizing, private working copies, JPEG metadata removal, saving and sharing.";
const [header, ...blocks] = policy.trim().split(/\n\n/);
const metadata = header.split("\n").slice(1);
const sections = blocks.map((block, index) => {
  const [heading, ...lines] = block.split("\n");
  return { heading, text: lines.join(" "), id: `policy-section-${index + 1}` };
});
---

<BaseLayout
  title="PhotoFeather Privacy Policy"
  description={pageDescription}
  canonicalPath={pagePath}
  structuredData={[
    organizationSchema,
    createPageSchema({ type: "WebPage", name: "PhotoFeather Privacy Policy", description: pageDescription, path: pagePath }),
    createBreadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Privacy", path: "/privacy/" },
      { name: "PhotoFeather", path: pagePath }
    ])
  ]}
>
  <HeroHeader
    eyebrow="PhotoFeather"
    title="PhotoFeather Privacy Policy"
    tagline="Photos are processed on your device. You choose what to save or share."
  />
  <Breadcrumbs items={[
    { label: "Home", href: "/" },
    { label: "Privacy", href: "/privacy/" },
    { label: "PhotoFeather" }
  ]} />
  <section class="content-card" aria-labelledby="policy-details-heading">
    <h2 id="policy-details-heading">About this policy</h2>
    {metadata.map((line) => <p>{line}</p>)}
  </section>
  {sections.map((section) => (
    <section class="content-card" aria-labelledby={section.id}>
      <h2 id={section.id}>{section.heading}</h2>
      <p>{section.text}</p>
    </section>
  ))}
  <section class="content-card" aria-labelledby="contact-link-heading">
    <h2 id="contact-link-heading">Contact Kreativ</h2>
    <p><a class="cta" href="mailto:info@madebykreativ.com">info@madebykreativ.com</a></p>
  </section>
</BaseLayout>
