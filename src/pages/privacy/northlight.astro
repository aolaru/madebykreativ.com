---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import HeroHeader from "../../components/HeroHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { createBreadcrumbSchema, createPageSchema, organizationSchema, site } from "../../data/site";

const pageDescription = "Northlight privacy policy: offline compass and light tools, device-local preferences, and optional Pro purchases through Google Play.";
const effectiveDate = "10 October 2026";
const pagePath = "/privacy/northlight/";
---

<BaseLayout
  title="Northlight Privacy Policy"
  description={pageDescription}
  canonicalPath={pagePath}
  structuredData={[
    organizationSchema,
    createPageSchema({
      type: "WebPage",
      name: "Northlight Privacy Policy",
      description: pageDescription,
      path: pagePath
    }),
    createBreadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Privacy", path: pagePath },
      { name: "Northlight", path: pagePath }
    ])
  ]}
>
  <HeroHeader
    eyebrow="Northlight"
    title="Northlight Privacy Policy"
    tagline="Offline compass and light tools, with optional Pro purchases through Google Play."
  />

  <Breadcrumbs items={[
    { label: "Home", href: "/" },
    { label: "Privacy" },
    { label: "Northlight" }
  ]} />

  <section class="content-card" aria-labelledby="effective-date-heading">
    <p class="eyebrow" id="effective-date-heading">Effective {effectiveDate}</p>
    <p>Northlight is a compass and lantern app made by Kreativ. Its compass and light tools are designed to work on your device.</p>
  </section>

  <section class="content-card" aria-labelledby="data-heading">
    <p class="eyebrow">Privacy</p>
    <h2 id="data-heading">Data we collect</h2>
    <p>Kreativ does not collect, sell, or share personal data through Northlight. The app has no account system, analytics, advertising SDKs, or developer-operated cloud services. Saved bearings, light-brightness preferences, a cached Pro entitlement, and pending purchase-confirmation tokens are stored only on your device. These app records are excluded from Android cloud backup and device transfer.</p>
  </section>

  <section class="content-card" aria-labelledby="pro-heading">
    <p class="eyebrow">Google Play Billing</p>
    <h2 id="pro-heading">Optional Northlight Pro purchase</h2>
    <p>Northlight Pro is an optional one-time purchase processed by Google Play. The app uses internet access to communicate with Google Play Billing when it opens, when you buy or restore Pro, and when it retries purchase confirmation in the background. This checks ownership and confirms completed purchases; compass and light tools remain usable offline. Google handles payment under its own <a href="https://policies.google.com/privacy">privacy policy</a>; Northlight does not receive or store payment-card details. Pending confirmation tokens are held locally by Android WorkManager for retries, and its completed-job records are subsequently pruned.</p>
  </section>

  <section class="content-card" aria-labelledby="permissions-heading">
    <p class="eyebrow">On-device permissions</p>
    <h2 id="permissions-heading">Device permissions</h2>
    <p>Northlight requests camera permission only when you use its LED lantern, SOS signal, or Pro strobe. Android requires this permission to control the camera flash. Northlight never takes photos, records video, or accesses your media.</p>
    <p>The compass uses your device's orientation sensors locally to show magnetic north. Sensor readings do not leave your device.</p>
  </section>

  <section class="content-card" aria-labelledby="children-heading">
    <p class="eyebrow">Children</p>
    <h2 id="children-heading">Children</h2>
    <p>Northlight does not knowingly collect personal information from anyone, including children.</p>
  </section>

  <section class="content-card" aria-labelledby="changes-heading">
    <p class="eyebrow">Changes</p>
    <h2 id="changes-heading">Changes</h2>
    <p>If this policy changes, the updated version will be published on this page with a revised effective date.</p>
  </section>

  <section class="content-card" aria-labelledby="contact-heading">
    <p class="eyebrow">Contact</p>
    <h2 id="contact-heading">Contact</h2>
    <p>For privacy questions, contact <a class="cta" href={`mailto:${site.email}`}>{site.email}</a>.</p>
  </section>

  <SiteFooter compact />
</BaseLayout>
