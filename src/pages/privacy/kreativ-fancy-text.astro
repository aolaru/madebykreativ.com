---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import HeroHeader from "../../components/HeroHeader.astro";
import PublicEmail from "../../components/PublicEmail.astro";
import PolicyText from "../../components/PolicyText.astro";
import {
  createBreadcrumbSchema,
  createPageSchema,
  organizationSchema,
} from "../../data/site";
import policy from "../../data/privacy/kreativ-fancy-text.txt?raw";

const pagePath = "/privacy/kreativ-fancy-text/";
const pageDescription =
  "Kreativ Fancy Text privacy policy: on-device text styling, local drafts and style presets, optional Google Play Pro purchases, PNG saving, and sharing only when you choose.";
const [header, scope, ...blocks] = policy.trim().split(/\n\n/);
const metadata = header.split("\n").slice(1);
const sectionHeadings = new Set([
  "Processing on your device",
  "Drafts, favorites, presets, and retention",
  "Clipboard, files, and sharing",
  "Optional Pro purchase",
  "Temporary image files",
  "Permissions and third-party components",
  "Support correspondence",
  "Changes and contact",
]);
const sections: { heading: string; paragraphs: string[]; id: string }[] = [];
for (const block of blocks) {
  const [heading, ...lines] = block.split("\n");
  if (sectionHeadings.has(heading)) {
    sections.push({
      heading,
      paragraphs: [lines.join(" ")],
      id: `policy-section-${sections.length + 1}`,
    });
  } else if (sections.length) {
    sections[sections.length - 1].paragraphs.push(block.replaceAll("\n", " "));
  }
}
---

<BaseLayout
  title="Kreativ Fancy Text Privacy Policy"
  description={pageDescription}
  canonicalPath={pagePath}
  structuredData={[
    organizationSchema,
    createPageSchema({
      type: "WebPage",
      name: "Kreativ Fancy Text Privacy Policy",
      description: pageDescription,
      path: pagePath,
    }),
    createBreadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Privacy", path: "/privacy/" },
      { name: "Kreativ Fancy Text", path: pagePath },
    ]),
  ]}
>
  <HeroHeader
    eyebrow="Kreativ Fancy Text"
    title="Kreativ Fancy Text Privacy Policy"
    tagline="Your text and designs stay on your device. You choose what to copy, save, or share."
  />
  <Breadcrumbs
    items={[
      { label: "Home", href: "/" },
      { label: "Privacy", href: "/privacy/" },
      { label: "Kreativ Fancy Text" },
    ]}
  />
  <section class="content-card" aria-labelledby="policy-details-heading">
    <h2 id="policy-details-heading">About this policy</h2>
    {metadata.map((line) => (
      <p>
        <PolicyText text={line} />
      </p>
    ))}
    <p>
      <PolicyText text={scope.replaceAll("\n", " ")} />
    </p>
  </section>
  {sections.map((section) => (
    <section class="content-card" aria-labelledby={section.id}>
      <h2 id={section.id}>{section.heading}</h2>
      {section.paragraphs.map((paragraph) => (
        <p>
          <PolicyText text={paragraph} />
        </p>
      ))}
    </section>
  ))}
  <section class="content-card" aria-labelledby="contact-link-heading">
    <h2 id="contact-link-heading">Contact Kreativ</h2>
    <p>
      <PublicEmail class="cta" />
    </p>
  </section>
</BaseLayout>
