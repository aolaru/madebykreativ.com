---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EngagementPackages from "../components/EngagementPackages.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import ProductCover from "../components/ProductCover.astro";
import { caseStudies } from "../data/caseStudies";
import { inquiryPath } from "../data/engagements";
import { scorecardProduct } from "../data/productToProfit";
import { storefrontHref } from "../../public/product-attribution.mjs";
import {
  activeProjects,
  buildUrl,
  organizationSchema,
  projectPath,
  websiteSchema,
} from "../data/site";
const latest = (await getCollection("news")).sort(
  (a, b) => b.data.sortDate.valueOf() - a.data.sortDate.valueOf(),
)[0];
---

<BaseLayout
  title="Software Development & QA | Made by KREATIV"
  description="Hire independent developer and software QA professional Andrei Olaru for scoped WordPress development, web tools and API testing. Real products, clear scope and direct communication."
  canonicalPath="/"
  ogImage={buildUrl("/og-services.png")}
  ogImageAlt="Made by KREATIV software development and QA, with real WordPress and Android project screenshots."
  structuredData={[organizationSchema, websiteSchema]}
>
  <header class="services-hero client-home-hero">
    <p class="eyebrow">Independent software development and QA</p>
    <h1>Made by Kreativ</h1>
    <p class="client-home-position">Custom software. Built and tested.</p>
    <p class="services-intro">
      I help small teams fix WordPress problems, build useful software and test
      their web applications and APIs.
    </p>
    <div class="landing-actions">
      <a
        class="button-cta button-cta-primary"
        href={inquiryPath()}
        data-service-cta
      >
        Discuss Your Project
      </a>
      <a class="button-cta button-cta-secondary" href="/services/">
        View Services
      </a>
    </div>
    <p class="services-hero-note">
      Andrei Olaru · Around 15 years in professional software QA · Direct
      collaboration
    </p>
  </header>

  <section class="services-section" aria-labelledby="home-engagements-heading">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Clear starting points</p>
        <h2 id="home-engagements-heading">What do you need solved?</h2>
      </div>
      <a class="cta" href="/services/">
        All development services
      </a>
    </div>
    <EngagementPackages compact />
    <p class="services-price-note">
      Indicative EUR starting prices. Scope, deliverables and the final
      quotation are agreed before work starts.
    </p>
  </section>

  <section class="services-section" aria-labelledby="home-work-heading">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Independent work, inspectable evidence</p>
        <h2 id="home-work-heading">How I approach the work</h2>
      </div>
      <a class="cta" href="/work/">
        All case studies
      </a>
    </div>
    <div class="case-grid">
      {caseStudies.map((study) => (
        <CaseStudyCard study={study} />
      ))}
    </div>
  </section>

  <section
    class="services-project-cta home-project-cta"
    aria-labelledby="home-project-heading"
  >
    <div>
      <h2 id="home-project-heading">
        A specific problem is a good starting point.
      </h2>
      <p>Tell me what needs building, fixing or testing.</p>
    </div>
    <a
      class="button-cta button-cta-primary"
      href={inquiryPath()}
      data-service-cta
    >
      Discuss Your Project
    </a>
  </section>

  <section class="services-section" aria-labelledby="home-products-heading">
    <p class="eyebrow">Also made by KREATIV</p>
    <h2 id="home-products-heading">Independent products and resources</h2>
    <div class="home-system-feature client-products">
      <article>
        <div class="client-product-image">
          <ProductCover
            src={scorecardProduct.cover}
            alt={scorecardProduct.coverAlt}
            sizes="(max-width: 700px) calc(100vw - 4rem), 280px"
          />
        </div>
        <h3>Product-to-Profit</h3>
        <p>
          Workbooks and editable tools for testing, building and launching a
          digital product.
        </p>
        <a class="cta" href="/product-to-profit/">
          Browse books and workbooks
        </a>
        <a
          class="client-product-secondary"
          href={storefrontHref(scorecardProduct.storeUrl, {
            page: "home",
            position: "resource-scorecard",
          })}
          target="_blank"
          rel="noopener"
          data-product-cta
          data-product={scorecardProduct.slug}
          data-stage={scorecardProduct.stage}
          data-page="home"
          data-position="resource-scorecard"
        >
          Get the free Scorecard
        </a>
      </article>
      <article>
        <div class="client-product-image">
          <img
            src="/apps/paperbuild/screen-320.webp"
            alt="PaperBuild, one of the independently published Android apps."
            width="1080"
            height="1920"
            loading="lazy"
          />
        </div>
        <h3>Android apps</h3>
        <p>
          Small utilities for photos, documents, typography and everyday tasks.
        </p>
        <a class="cta" href="/apps/">
          View all apps
        </a>
      </article>
      <article>
        <div class="client-product-image">
          <img
            src="/services/work/report-broken-link.webp"
            alt="A published Kreativ WordPress plugin dashboard."
            width="960"
            height="600"
            loading="lazy"
          />
        </div>
        <h3>Websites and plugins</h3>
        <p>
          Published projects, practical web tools and their current maintenance
          status.
        </p>
        <a class="cta" href="/projects/">
          View the project directory
        </a>
      </article>
    </div>
    <div class="client-active-projects" id="active-projects">
      <p class="eyebrow">Active web projects</p>
      <div>
        {activeProjects.map((project) => (
          <a href={projectPath(project.slug)}>{project.label}</a>
        ))}
      </div>
      <a href="/projects/#community-projects">
        Open-source contributor projects
      </a>
    </div>
  </section>
  {latest && (
    <a class="home-latest" href={`/news/${latest.id.replace(/\.md$/, "")}/`}>
      <span class="home-latest-label">Latest article</span>
      <strong>{latest.data.title}</strong>
      <span class="home-latest-date">{latest.data.dateLabel}</span>
      <span class="home-project-arrow" aria-hidden="true">
        →
      </span>
    </a>
  )}
</BaseLayout>
