---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroHeader from "../components/HeroHeader.astro";
import ProductCover from "../components/ProductCover.astro";
import ProjectLogo from "../components/ProjectLogo.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
  bundleProduct,
  productPath as productToProfitPath,
  scorecardProduct,
  stageProducts,
  systemPath
} from "../data/productToProfit";
import {
  activeProjects,
  buildUrl,
  organizationSchema,
  projectPath,
  websiteSchema
} from "../data/site";

const latestNews = (await getCollection("news"))
  .filter((entry) => !entry.id.startsWith("maintenance-open-source-transition"))
  .sort((a, b) => b.data.sortDate.valueOf() - a.data.sortDate.valueOf())
  .slice(0, 1)
  .map((entry) => ({
    ...entry,
    path: `/news/${entry.id.replace(/\.md$/, "")}/`
  }));

const continuationProducts = [
  stageProducts.find((product) => product.slug === "workflow-product-builder")!,
  stageProducts.find((product) => product.slug === "digital-product-launch-engine")!,
  bundleProduct
];
---

<BaseLayout
  title="Made by Kreativ | Independent Products and Active Projects"
  description="Made by Kreativ is Andrei Olaru's active independent product studio, home to Product-to-Profit and five focused digital projects."
  canonicalPath="/"
  ogImage={buildUrl("/og-home.png")}
  ogImageAlt="Made by Kreativ overview card for independent products and active projects."
  structuredData={[organizationSchema, websiteSchema]}
>
  <HeroHeader
    current="home"
    showLogo={false}
    eyebrow="Independent product studio"
    title="Made by Kreativ"
    tagline="Active digital products and focused independent projects by Andrei Olaru."
  >
    <div slot="afterTagline" class="hero-home-after">
      <div class="landing-actions hero-home-actions">
        <a class="button-cta button-cta-primary" href="/product-to-profit/">Explore Product-to-Profit</a>
        <a class="button-cta button-cta-secondary" href="#active-projects">View active projects</a>
      </div>
      <p class="meta-note home-status-note">Active product studio · five ongoing projects</p>
    </div>
  </HeroHeader>

  <section class="home-system-feature" aria-labelledby="home-system-heading">
    <div class="home-system-copy">
      <p class="eyebrow">KREATIV Product-to-Profit</p>
      <h2 id="home-system-heading">Choose a product worth testing. Build it. Launch it. Improve it.</h2>
      <p>A connected set of practical workbooks and editable tools for moving from several possible ideas to one tested digital product and a clear buyer path.</p>
      <div class="landing-actions home-system-actions">
        <a
          class="button-cta button-cta-primary"
          href={scorecardProduct.storeUrl}
          target="_blank"
          rel="noopener"
          data-product-cta
          data-product={scorecardProduct.slug}
          data-stage={scorecardProduct.stage}
          data-page="home"
          data-position="feature-primary"
        >Get the Free Product Idea Scorecard <span aria-hidden="true">↗</span></a>
        <a
          class="button-cta button-cta-secondary"
          href={bundleProduct.storeUrl}
          target="_blank"
          rel="noopener"
          data-product-cta
          data-product={bundleProduct.slug}
          data-stage={bundleProduct.stage}
          data-page="home"
          data-position="feature-secondary"
        >Explore the Complete System <span aria-hidden="true">↗</span></a>
      </div>
      <p class="home-system-note"><strong>Recommended start:</strong> the Scorecard is free / pay what you want. <a class="cta" href={systemPath}>Compare every stage</a></p>
    </div>
    <div class="home-system-visual">
      <a class="home-system-media" href={productToProfitPath(scorecardProduct.slug)} aria-label="View the Product Idea Scorecard details">
        <ProductCover src={scorecardProduct.cover} alt={scorecardProduct.coverAlt} loading="eager" sizes="(max-width: 900px) calc(100vw - 2rem), 520px" />
      </a>
      <div class="home-system-continuation" role="group" aria-label="Continue into the Builder, Launch Engine, and complete system">
        {continuationProducts.map((product) => (
          <a href={productToProfitPath(product.slug)} aria-label={`View ${product.shortTitle}`}>
            <ProductCover src={product.cover} alt="" sizes="120px" />
            <span>{product.shortTitle}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-featured" id="active-projects" aria-labelledby="home-featured-heading">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Current work</p>
        <h2 id="home-featured-heading">Active projects</h2>
        <p>Five independent properties currently developed and maintained under Made by KREATIV.</p>
      </div>
      <a class="cta" href="/projects/">Project directory</a>
    </div>
    <div class="home-public-grid">
      {activeProjects.map((project) => (
        <article class="content-card home-public-card">
          <div class="home-public-card-header">
            <ProjectLogo slug={project.slug} mark={project.logo.mark} />
            <div>
              <span class="pillar-status">{project.status}</span>
              <h3>{project.label}</h3>
            </div>
          </div>
          <p>{project.description}</p>
          <div class="home-public-actions">
            <a class="cta" href={projectPath(project.slug)}>Overview</a>
            <a class="cta" href={project.href} target="_blank" rel="noopener">Public site</a>
          </div>
        </article>
      ))}
    </div>
    <div class="home-archive-summary">
      <span><strong>Open-source projects:</strong> Kreativ Tools, Findsera, and News Ledger are available to contributors under their published licenses.</span>
      <a class="cta" href="/projects/#community-projects">View open-source projects</a>
    </div>
  </section>

  {latestNews.map((entry) => (
    <a class="home-latest" href={entry.path}>
      <span class="home-latest-label">Latest</span>
      <strong>{entry.data.title}</strong>
      <span class="home-latest-date">{entry.data.dateLabel}</span>
      <span class="home-project-arrow" aria-hidden="true">→</span>
    </a>
  ))}

  <SiteFooter compact />
</BaseLayout>
