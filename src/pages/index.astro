---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroHeader from "../components/HeroHeader.astro";
import ProjectLogo from "../components/ProjectLogo.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
  buildUrl,
  ecosystemItemListSchema,
  organizationSchema,
  products,
  projectPath,
  websiteSchema
} from "../data/site";

const latestNews = (await getCollection("news"))
  .sort((a, b) => b.data.sortDate.valueOf() - a.data.sortDate.valueOf())
  .slice(0, 1)
  .map((entry) => ({
    ...entry,
    path: `/news/${entry.id.replace(/\.md$/, "")}/`
  }));
---

<BaseLayout
  title="Made by Kreativ | Creative Tools and Digital Product Guides"
  description="Made by Kreativ collects practical creative tools, digital product guides, curated assets, and utility software built by Andrei Olaru."
  canonicalPath="/"
  ogImage={buildUrl("/og-home.png")}
  ogImageAlt="Made by Kreativ overview card for creative tools, guides, and utility software."
  structuredData={[organizationSchema, websiteSchema, ecosystemItemListSchema]}
>
  <HeroHeader
    current="home"
    showLogo={false}
    eyebrow="Independent digital studio"
    title="Made by Kreativ"
    tagline="Useful tools, focused projects, and practical guides."
  >
    <div slot="afterTagline" class="landing-actions hero-home-actions">
      <a class="button-cta button-cta-primary" href="/projects/">Explore projects</a>
      <a class="button-cta button-cta-secondary" href="/guides/">Open guides</a>
    </div>
  </HeroHeader>

  <section class="home-featured" aria-labelledby="home-featured-heading">
    <div class="section-heading-row">
      <h2 id="home-featured-heading">Featured projects</h2>
      <a class="cta" href="/projects/">View all</a>
    </div>
    <div class="home-project-grid">
      {products.map((project) => (
        <a class="home-project-link" href={projectPath(project.slug)}>
          <ProjectLogo slug={project.slug} mark={project.logo.mark} />
          <span>
            <strong>{project.label}</strong>
            <small>{project.status}</small>
          </span>
          <span class="home-project-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  {latestNews.map((entry) => (
    <a class="home-latest" href={entry.path}>
      <span class="home-latest-label">Latest</span>
      <strong>{entry.data.title}</strong>
      <span class="home-latest-date">{entry.data.dateLabel}</span>
      <span class="home-project-arrow" aria-hidden="true">→</span>
    </a>
  ))}

  <SiteFooter compact />
</BaseLayout>
