---
import type { ProductToProfitProduct } from "../data/productToProfit";

interface Props {
  product: ProductToProfitProduct;
}

const { product } = Astro.props;
---

<section class="ptp-section ptp-preview-section" aria-labelledby={`${product.slug}-preview-heading`}>
  <div class="ptp-section-heading">
    <p class="eyebrow">Real workbook pages</p>
    <h2 id={`${product.slug}-preview-heading`}>Inspect the working material</h2>
    <p>Package {product.delivery.version}, released {product.released}. {product.slug === "ai-business-pathways" ? "Guide v1.2; prompt vault v1.1." : `Main PDF ${product.pdfVersion}${product.pages ? `, ${product.pages} pages` : ""}${product.fields ? `, ${product.fields} fillable fields` : ""}.`}</p>
  </div>
  <div class:list={["ptp-preview-grid", { "ptp-preview-grid-single": product.previews.length === 1 }]}>
    {product.previews.slice(0, 2).map((preview) => (
      <a href={preview.src} target="_blank" rel="noopener" class="ptp-preview">
        <img
          src={preview.src.replace(/\.png$/, ".webp")}
          alt={preview.alt}
          width={preview.width}
          height={preview.height}
          loading="lazy"
          decoding="async"
        />
        <span>{preview.label}<span aria-hidden="true"> ↗</span></span>
      </a>
    ))}
  </div>
  {product.previews.length > 2 && <details class="ptp-details"><summary>More workbook previews</summary><ul>{product.previews.slice(2).map((preview)=><li><a href={preview.src} target="_blank" rel="noopener">{preview.label}</a></li>)}</ul></details>}
</section>
