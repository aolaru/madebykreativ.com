---
import { caseStudyPath, type caseStudies } from "../data/caseStudies";
interface Props {
  study: (typeof caseStudies)[number];
}
const { study } = Astro.props;
---

<article class="case-card">
  <a
    class="case-card-image"
    href={caseStudyPath(study.slug)}
    aria-label={`Read case study: ${study.shortTitle}`}
  >
    <img
      src={study.image}
      alt={study.imageAlt}
      width={study.width}
      height={study.height}
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="case-card-copy">
    <p class="eyebrow">{study.category} · Independent work</p>
    <h3>
      <a href={caseStudyPath(study.slug)}>{study.shortTitle}</a>
    </h3>
    <p>{study.summary}</p>
    <a class="cta" href={caseStudyPath(study.slug)}>
      Read the case study
    </a>
  </div>
</article>
