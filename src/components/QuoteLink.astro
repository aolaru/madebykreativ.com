---
import { projectInquiryHref } from "../data/services";
import PublicEmail from "./PublicEmail.astro";
interface Props {
  variant?: "primary" | "secondary";
}
const { variant = "primary" } = Astro.props;
---

<PublicEmail
  class={`button-cta button-cta-${variant}`}
  href={projectInquiryHref}
>
  Request a Quote
</PublicEmail>
