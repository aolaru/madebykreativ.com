---
import { projectPath, publicProjects } from "../data/site";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<footer class="footer">
  {!compact && (
    <nav class="ecosystem-links" aria-label="Made by Kreativ project links">
      {publicProjects.map((project) => (
        <a href={projectPath(project.slug)}>{project.label}</a>
      ))}
      <a href="/projects/#past-work">Past Work</a>
      <a href="/news/">Updates</a>
    </nav>
  )}
  <p>© <span id="year"></span> Made by KREATIV{compact ? " · Andrei Olaru" : " · Semi-retired independent projects by Andrei Olaru"}</p>
</footer>
