---
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: "eager" | "lazy";
  sizes?: string;
}

const {
  src,
  alt,
  class: className,
  loading = "lazy",
  sizes = "(max-width: 900px) calc(100vw - 2rem), 520px"
} = Astro.props;
const assetBase = src.replace(/\.png$/, "");
---

<picture class={className}>
  <source
    type="image/webp"
    srcset={`${assetBase}-600.webp 600w, ${assetBase}-1200.webp 1200w`}
    sizes={sizes}
  />
  <img
    src={src}
    alt={alt}
    width="1200"
    height="675"
    loading={loading}
    decoding="async"
  />
</picture>

<style>
  picture,
  img {
    display: block;
    width: 100%;
    height: auto;
  }

  picture {
    min-width: 0;
  }
</style>
