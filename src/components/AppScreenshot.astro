---
interface Props {
  slug: string;
  alt: string;
  width: number;
  height: number;
  class?: string;
  loading?: "eager" | "lazy";
}
const {
  slug,
  alt,
  width,
  height,
  class: className,
  loading = "lazy",
} = Astro.props;
---

<img
  class={className}
  src={`/apps/${slug}/screen-640.webp`}
  srcset={`/apps/${slug}/screen-320.webp 320w, /apps/${slug}/screen-640.webp 640w, /apps/${slug}/screen-1080.webp 1080w`}
  sizes="(max-width: 600px) 260px, 300px"
  width={width}
  height={height}
  alt={alt}
  loading={loading}
  decoding="async"
/>
