---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import ProductCover from "./ProductCover.astro";
import ProductPreviewGallery from "./ProductPreviewGallery.astro";
import ProductStoreAction from "./ProductStoreAction.astro";
import SystemStagePath from "./SystemStagePath.astro";
import {
  productPath,
  productInformationPath,
  productPolicies,
  systemPath,
  type ProductToProfitProduct,
} from "../data/productToProfit";
import { buildUrl, createPageSchema, organizationSchema } from "../data/site";
interface Props {
  product: ProductToProfitProduct;
}
const { product } = Astro.props;
const path = productPath(product.slug);
const isBundle = product.slug === "system";
const title = `${product.title} | Made by Kreativ`;
---

<BaseLayout
  title={title}
  description={product.description}
  canonicalPath={path}
  ogImage={buildUrl(product.cover)}
  ogImageAlt={product.coverAlt}
  ogImageWidth="1200"
  ogImageHeight="675"
  structuredData={[
    organizationSchema,
    createPageSchema({ name: title, description: product.description, path }),
  ]}
>
  <header class:list={["ptp-product-header", `ptp-accent-${product.accent}`]}>
    <div class="ptp-product-hero">
      <div class="ptp-product-hero-copy">
        <div class="ptp-product-hero-meta">
          <p class="eyebrow">{product.stage}</p>
          <span
            class:list={["ptp-access-badge", `ptp-access-${product.access}`]}
          >
            {product.accessSummary}
          </span>
        </div>
        <h1>{product.title}</h1>
        <p class="ptp-product-promise">{product.promise}</p>
        <div class="landing-actions">
          <ProductStoreAction
            product={product}
            page={product.slug}
            position="hero"
            showStatus={false}
          />
          <a class="cta" href="#included">
            What is included
          </a>
        </div>
        <p class="meta-note">
          Package {product.delivery.version} · released {product.released} ·{" "}
          {product.delivery.fileCount} files
        </p>
      </div>
      <ProductCover
        class="ptp-product-cover"
        src={product.cover}
        alt={product.coverAlt}
        loading="eager"
      />
    </div>
  </header>
  <div class:list={["ptp-product-content", `ptp-accent-${product.accent}`]}>
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Product-to-Profit", href: systemPath },
        { label: product.shortTitle },
      ]}
    />
    <details class="ptp-details">
      <summary>Where this fits in the system</summary>
      <SystemStagePath currentHref={path} compact />
    </details>
    <section class="ptp-section" aria-labelledby="result-heading">
      <h2 id="result-heading">Start with this. Leave with this.</h2>
      <dl class="ptp-contract-grid">
        <div>
          <dt>Your input</dt>
          <dd>{product.requiredInput}</dd>
        </div>
        <div>
          <dt>Your result</dt>
          <dd>{product.output}</dd>
        </div>
      </dl>
    </section>
    <section
      class="ptp-section"
      id="included"
      aria-labelledby="included-heading"
    >
      <h2 id="included-heading">Inside the package</h2>
      <ul class="ptp-check-grid">
        {product.included.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <details class="ptp-details">
        <summary>Files, compatibility, and first use</summary>
        <p>
          {product.delivery.packageName} · {product.delivery.packageSize} ·{" "}
          {product.delivery.fileCount} files
        </p>
        <p>{product.delivery.formats.join(", ")}</p>
        <p>{productPolicies.compatibility}</p>
        <ul>
          {product.delivery.contents.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <p>
          <strong>First action:</strong> {product.delivery.firstStep}
        </p>
      </details>
      {isBundle && (
        <div class="ptp-bundle-difference">
          <h3>What the bundle adds</h3>
          <p>
            All five individual products, a cross-stage master workspace, integrated
            handoffs, and Weekend, Seven-Day MVP, and Thirty-Day implementation
            tracks. Builder and Launch Engine cost €38 together; the €39 bundle
            also includes the €19 AI Business Pathways.
          </p>
          <p>
            The fictional case study and six editable sample DOCX files are also
            included with the standalone Builder. They are not bundle-exclusive
            bonuses.
          </p>
          <figure class="workspace-preview">
            <a href="/product-to-profit/previews/system/workspace-dashboard.png" target="_blank" rel="noopener">
              <img src="/product-to-profit/previews/system/workspace-dashboard.webp" width="1640" height="400" loading="lazy" alt="Actual master workspace v2.2 dashboard: five stage artifacts, completion percentages, gate status and next actions, shown before any inputs are completed." />
            </a>
            <figcaption>The actual Excel master workspace v2.2, included in system package v2.4. This empty-state preview shows the stage gates before you enter your own product evidence. <a class="cta" href="/product-to-profit/previews/system/workspace-dashboard.png" target="_blank" rel="noopener">Full-size workspace preview</a></figcaption>
          </figure>
        </div>
      )}
      <p>
        <a class="cta" href="/product-to-profit/example/">
          See a completed fictional product brief
        </a>
      </p>
    </section>
    <ProductPreviewGallery product={product} />
    <section class="ptp-section" aria-label="Scope and purchase policies">
      <details class="ptp-details">
        <summary>What this product does not do</summary>
        <ul>
          {product.exclusions.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <p>
          These are workbooks and tools, not guarantees of traffic, customers,
          sales, or income.
        </p>
      </details>
      <details class="ptp-details">
        <summary>License, support, and refunds</summary>
        <p>{productPolicies.license}</p>
        <p>{productPolicies.support}</p>
        <p>{productPolicies.refunds}</p>
        <a class="cta" href={productInformationPath}>
          Full product policies
        </a>
      </details>
    </section>
    <section
      class="ptp-section ptp-final-section"
      aria-labelledby="purchase-heading"
    >
      <div>
        <h2 id="purchase-heading">
          {product.access === "free"
            ? "Get the free package"
            : `Get ${product.shortTitle}`}
        </h2>
        <p>
          {product.access === "free"
            ? "Choose €0 at Gumroad checkout, or optionally pay more."
            : "One-time purchase. The amount and any applicable tax are shown at Gumroad checkout."}
        </p>
        <p>{product.pricingNote}</p>
      </div>
      <div class="landing-actions">
        <ProductStoreAction
          product={product}
          page={product.slug}
          position="final"
          showStatus={false}
        />
        {product.nextSlug && (
          <a class="cta" href={productPath(product.nextSlug)}>
            Next: {product.nextLabel}
          </a>
        )}
      </div>
    </section>
  </div>
</BaseLayout>
