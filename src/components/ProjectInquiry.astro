---
import InquiryTools from "./InquiryTools.astro";
import PublicEmail from "./PublicEmail.astro";
import { inquiryOptions } from "../data/engagements";
import { site } from "../data/site";
---

<section
  class="services-section project-inquiry"
  id="project-inquiry"
  aria-labelledby="paid-project-heading"
>
  <p class="eyebrow">Work directly with Andrei Olaru</p>
  <h2 id="paid-project-heading">Tell me about your project</h2>
  <p>
    Share the problem you need solved. I'll review the fit, clarify the scope
    and discuss a proposal before any work starts.
  </p>
  <p class="services-price-note">
    Selected, fixed-scope projects, subject to availability. Sending shares your
    reply address and brief with Andrei for this inquiry. No passwords, API keys
    or confidential customer data. <a href="/privacy/">Privacy details</a>.
  </p>
  <form
    data-project-inquiry
    data-email={site.email}
    action="/api/inquiry"
    method="post"
  >
    <input type="hidden" name="source" value="direct" />
    <div class="inquiry-honeypot" aria-hidden="true">
      <label for="inquiry-website">Leave this field empty</label>
      <input
        id="inquiry-website"
        name="website"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>
    <div class="project-inquiry-fields">
      <div>
        <label for="inquiry-name">Name (optional)</label>
        <input
          id="inquiry-name"
          name="name"
          type="text"
          maxlength="80"
          autocomplete="name"
        />
      </div>
      <div>
        <label for="inquiry-email">Reply email</label>
        <input
          id="inquiry-email"
          name="email"
          type="email"
          maxlength="254"
          autocomplete="email"
          required
        />
      </div>
      <div>
        <label for="inquiry-service">Project type</label>
        <select id="inquiry-service" name="service" required>
          <option value="">Choose a project type</option>
          {inquiryOptions.map((item) => (
            <option value={item.id}>{item.label}</option>
          ))}
        </select>
      </div>
      <div>
        <label for="inquiry-budget">Approximate budget (EUR, optional)</label>
        <input
          id="inquiry-budget"
          name="budget"
          type="number"
          min="0"
          max="1000000"
          step="any"
          inputmode="decimal"
        />
      </div>
      <div class="inquiry-wide">
        <label for="inquiry-summary">What needs building or fixing?</label>
        <textarea
          id="inquiry-summary"
          name="summary"
          rows="4"
          maxlength="1500"
          required
        ></textarea>
      </div>
      <div class="inquiry-wide">
        <label for="inquiry-functionality">
          Required functionality (optional)
        </label>
        <textarea
          id="inquiry-functionality"
          name="functionality"
          rows="3"
          maxlength="1000"
        ></textarea>
      </div>
      <div>
        <label for="inquiry-deadline">Desired deadline (optional)</label>
        <input id="inquiry-deadline" name="deadline" type="date" />
      </div>
      <div>
        <label for="inquiry-links">Relevant public link (optional)</label>
        <input id="inquiry-links" name="links" type="url" maxlength="500" />
      </div>
    </div>
    <label class="inquiry-consent">
      <input type="checkbox" name="consent" value="yes" required /> Send these
      details to Andrei to discuss this project.
    </label>
    <div class="landing-actions">
      <button
        type="submit"
        class="button-cta button-cta-primary"
        data-inquiry-submit
      >
        Send Inquiry
      </button>
      <button
        type="button"
        class="button-cta button-cta-secondary"
        data-prepare-inquiry
        hidden
      >
        Prepare Email Instead
      </button>
    </div>
    <div data-inquiry-result role="status" tabindex="-1" hidden></div>
  </form>
  <div
    class="project-inquiry-preview"
    data-project-draft
    data-inquiry-tools
    hidden
  >
    <h3 id="draft-heading" tabindex="-1">
      Your project brief
    </h3>
    <label for="project-brief-draft">Email draft</label>
    <textarea id="project-brief-draft" rows="10" readonly></textarea>
    <div class="landing-actions">
      <PublicEmail
        class="button-cta button-cta-primary"
        data-project-email
        href={`mailto:${site.email}`}
      >
        Open Email Draft
      </PublicEmail>
      <button
        class="icon-button"
        title="Copy completed project brief"
        aria-label="Copy completed project brief"
        type="button"
        data-copy-target="project-brief-draft"
      >
        <span class="copy-glyph" aria-hidden="true"></span>
      </button>
      <span class="copy-status" data-inquiry-copy-status role="status"></span>
    </div>
    <p class="services-price-note">
      This email draft has not been sent. Review and send it in your email app, or
      copy it into your preferred email service.
    </p>
  </div>
  <InquiryTools id="contact-inquiry" />
</section>
